// /Project/Looks/ThrowArc.ush
//
// The throw preview's ribbon: flat colour, unlit and emissive-only, so it reads the same in a dark crypt and a lit
// kitchen. Its look definition makes it translucent, two-sided and drawn without a depth test, so it shows from above and
// below and over everything in front of it, the held item included. Opacity stays at the default 1.
#pragma once
#include "/CkUsf/Common.ush"

FCkUsf_SurfaceOutput Mars_Look_ThrowArc(
    FCkUsf_SurfaceInput In,
    float3              Tint,
    float               Brightness)
{
    FCkUsf_SurfaceOutput O = CkUsf_DefaultSurface();
    O.BaseColor     = float3(0.0f, 0.0f, 0.0f);
    O.EmissiveColor = Tint * Brightness;
    return O;
}
