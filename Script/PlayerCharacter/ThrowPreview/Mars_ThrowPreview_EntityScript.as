// A flat quad (the engine plane, 100 cm, facing +Z) on its own scene node: the landing rings and the power bar.
struct FMars_ThrowPreview_Quad
{
    // Relative to the node the quad hangs off; its scale sizes the 100 cm plane.
    UPROPERTY()
    FTransform Local = FTransform::Identity;

    // Unset keeps the plane's own material (headless: no look is compiled).
    UPROPERTY()
    UMaterialInterface Material;

    UPROPERTY()
    FName DebugName;

    UPROPERTY()
    EFirstPersonPrimitiveType FirstPerson = EFirstPersonPrimitiveType::None;
}

// What the owning player sees of an armed throw: a glowing ribbon along the predicted path ending in an arrowhead on the
// spot it lands, concentric rings laid on that spot, and a power bar beside the gloves filling as the throw charges. Reads
// the kernels (the path, the throw's power); writes only its own polyline and quads. The path arrives by the kernel's
// signals, which fire in the camera group, so the polyline (drained in FGroup_PostTransform) draws the path of the frame
// being rendered; nothing here ticks.
class UMars_ThrowPreview_EntityScript : UCk_GenericEntityScript_UE
{
    default _Replication = ECk_Replication::DoesNotReplicate;

    UPROPERTY(ExposeOnSpawn)
    FCk_Handle_ThrowPreview Preview;

    // Half the ribbon's width: room for the glow around its core.
    private const float32 k_ArcHalfWidth = 4.0f;
    private const int32 k_ArcMaxPoints = 64;
    private const float32 k_ArrowLength = 22.0f;
    // Half the arrowhead's width at its base.
    private const float32 k_ArrowHalfWidth = 9.0f;
    // The arc starts this far along the path, clear of the gloves and the held item.
    private const float32 k_HandClearance = 25.0f;
    // Off the surface, so the arrowhead and the rings do not sit in it.
    private const float32 k_SurfaceLift = 0.8f;

    private const float32 k_RingDiameter = 70.0f;

    // The power bar in the view's frame (X forward, Y right, Z up) - fixed on screen right of the gloves, so lowering them
    // does not take it with them. The engine plane's U runs along its X and V along its Y (seen in PIE 2026-11-15), so it is
    // turned to face the eye with its X to the right and its Y down: its UV then runs right (U) and down (V), as
    // ThrowPower.ush reads it.
    private const FVector k_PowerBarLocation = FVector(40.0, 17.0, -13.0);
    // Height (along the plane's Y, screen down) and width (along its X, screen right), cm.
    private const FVector2D k_PowerBarSize = FVector2D(14.0, 6.0);

    private FCk_Handle_Pmg_Polyline _Arc;
    private FCk_Handle_Transform _RingRoot;
    private FCk_Handle_UnrealComponent _Ring;
    private FCk_Handle_SceneNode _PowerBarNode;
    private FCk_Handle_UnrealComponent _PowerBar;
    private FCk_Handle_HeldItemUse _Use;
    private bool _Bound = false;
    // Set by OnAimChanged; the bar shows only while it is.
    private bool _Aiming = false;

    FCk_Handle_Pmg_Polyline Get_Arc() const { return _Arc; }

    UFUNCTION(BlueprintOverride)
    ECk_EntityScript_ConstructionFlow DoConstruct(FCk_Handle& InHandle)
    {
        if (ck::EnsureIfNot(ck::IsValid(Preview), f"[ThrowPreview] [{InHandle.ToString()}] was spawned without a preview to draw"))
        {
            utils_entity_lifetime::Request_DestroyEntity(InHandle);
            return ECk_EntityScript_ConstructionFlow::Finished;
        }

        FCk_Handle Player = Preview;
        _Use = Player.As_HeldItemUse(ECk_SanityCheck::UnChecked);

        auto ArcSpec = FCk_Pmg_Polyline_Spec();
        ArcSpec.Set_Material(Get_LookMaterial(MarsThrowArc));
        ArcSpec.Set_Profile(ECk_Pmg_Polyline_Profile::Ribbon);
        ArcSpec.Set_Radius(k_ArcHalfWidth);
        ArcSpec.Set_MaxPoints(k_ArcMaxPoints);
        ArcSpec.Set_ArrowLength(k_ArrowLength);
        ArcSpec.Set_ArrowRadius(k_ArrowHalfWidth);
        _Arc = utils_pmg_polyline::Create(InHandle, ArcSpec);

        // The rings ride this script's own transform, moved onto each landing.
        _RingRoot = utils_transform::Add(InHandle, FTransform::Identity, ECk_Replication::DoesNotReplicate);
        auto Ring = FMars_ThrowPreview_Quad();
        Ring.Local = FTransform(FRotator::ZeroRotator, FVector::ZeroVector, FVector(k_RingDiameter / 100.0, k_RingDiameter / 100.0, 1.0));
        Ring.Material = Get_LookMaster(MarsThrowRing);
        Ring.DebugName = n"ThrowPreview_Rings";
        _Ring = Add_Quad(_RingRoot, Ring).Component;

        Add_PowerBar(Player);

        Preview.BindTo_OnPathUpdated(FMars_Delegate_ThrowPreview_OnPathUpdated(this, n"OnPathUpdated"));
        Preview.BindTo_OnAimChanged(FMars_Delegate_ThrowPreview_OnAimChanged(this, n"OnAimChanged"));
        _Bound = true;
        return ECk_EntityScript_ConstructionFlow::Finished;
    }

    UFUNCTION(BlueprintOverride)
    void DoEndPlay(FCk_Handle InHandle)
    {
        if (_Bound && ck::IsValid(Preview))
        {
            Preview.UnbindFrom_OnPathUpdated(FMars_Delegate_ThrowPreview_OnPathUpdated(this, n"OnPathUpdated"));
            Preview.UnbindFrom_OnAimChanged(FMars_Delegate_ThrowPreview_OnAimChanged(this, n"OnAimChanged"));
        }

        _Bound = false;

        // The bar hangs off the player's view, not this script: it goes when the script does.
        if (ck::IsValid(_PowerBarNode))
        { utils_entity_lifetime::Request_DestroyEntity(_PowerBarNode.H()); }
    }

    // On the view the gloves' pitch node hangs from; left out for a player without gloves (headless rigs). This copy is
    // the locally controlled one (AMars_PlayerCharacter::TryConstructThrowPreviewVisual), so it renders first-person.
    private void Add_PowerBar(FCk_Handle& InPlayer)
    {
        auto Hands = InPlayer.As_FPHands(ECk_SanityCheck::UnChecked);
        if (ck::Is_NOT_Valid(Hands) || ck::Is_NOT_Valid(Hands.Get_Spec().Pitch.Node))
        { return; }

        auto View = Hands.Get_Spec().Pitch.Node.Get_Parent();
        if (ck::Is_NOT_Valid(View))
        { return; }

        auto Bar = FMars_ThrowPreview_Quad();
        // Plane X -> view right, plane Z (its face) -> back toward the eye; so plane Y -> view down.
        const auto Facing = FRotator::MakeFromXZ(FVector(0.0, 1.0, 0.0), FVector(-1.0, 0.0, 0.0));
        Bar.Local = FTransform(Facing, k_PowerBarLocation,
            FVector(k_PowerBarSize.Y / 100.0, k_PowerBarSize.X / 100.0, 1.0));
        Bar.Material = Get_LookMaster(MarsThrowPower);
        Bar.DebugName = n"ThrowPreview_PowerBar";
        Bar.FirstPerson = EFirstPersonPrimitiveType::FirstPerson;

        const auto Added = Add_Quad(View, Bar);
        _PowerBarNode = Added.Node;
        _PowerBar = Added.Component;
    }

    // The quad on a new scene node under InParent, hidden until the preview shows it (the component is created later).
    private FMars_ThrowPreview_AddedQuad Add_Quad(FCk_Handle_Transform& InParent, const FMars_ThrowPreview_Quad& InQuad)
    {
        auto Added = FMars_ThrowPreview_AddedQuad();
        auto Plane = Cast<UStaticMesh>(LoadObject(this, "/Engine/BasicShapes/Plane.Plane"));
        if (ck::EnsureIfNot(ck::IsValid(Plane), f"[ThrowPreview] the engine plane is missing; [{InQuad.DebugName}] is left out"))
        { return Added; }

        Added.Node = utils_scene_node::Create(InParent, InQuad.Local);

        auto Archetype = NewObject(this, UStaticMeshComponent);
        // Movable: the component is registered first and then receives the entity transform.
        Archetype.SetMobility(EComponentMobility::Movable);
        Archetype.SetStaticMesh(Plane);
        if (ck::IsValid(InQuad.Material))
        { Archetype.SetMaterial(0, InQuad.Material); }
        Archetype.SetCollisionProfileName(collision::profile::NoCollision);
        Archetype.SetCastShadow(false);
        Archetype.SetReceivesDecals(false);
        Archetype.SetVisibility(false);
        Archetype.SetFirstPersonPrimitiveType(InQuad.FirstPerson);

        auto Params = utils_unreal_component::Make_Params_FromArchetype(Archetype, ECk_UnrealComponent_TickPolicy::DoNotTick, InQuad.DebugName);
        Added.Component = utils_unreal_component::Add(Added.Node.H(), Params);
        return Added;
    }

    // The look's master, or none where nothing can render: a headless boot compiles no look, and CkUsf warns about every
    // master it is asked for there (the polyline and quads are still made, on the engine's default material). Where
    // something renders, a missing master is an ensure naming the look.
    private UMaterialInterface Get_LookMaster(UCkUsf_LookDefinition InLook) const
    {
        if (FApp::CanEverRender() == false)
        { return nullptr; }

        auto Master = utils_usf::Get_LookMasterMaterial(InLook);
        if (ck::EnsureIfNot(ck::IsValid(Master),
            f"[ThrowPreview] the {InLook.GetName()} look master is not generated - run Ck_Usf_GenerateLooks {InLook.GetName()}"))
        { return nullptr; }

        return Master;
    }

    private TSoftObjectPtr<UMaterialInterface> Get_LookMaterial(UCkUsf_LookDefinition InLook) const
    {
        auto Master = Get_LookMaster(InLook);
        if (ck::Is_NOT_Valid(Master))
        { return TSoftObjectPtr<UMaterialInterface>(); }

        return TSoftObjectPtr<UMaterialInterface>(FSoftObjectPath(Master));
    }

    UFUNCTION()
    private void OnPathUpdated(FCk_Handle_ThrowPreview InPreview)
    {
        // Going Idle broadcasts OnAimChanged and then one last OnPathUpdated with the path cleared, while the Aiming tag's
        // removal is still deferred: the bar follows this script's own record of the aim, so it stays hidden.
        Show_Power(_Aiming);

        const auto Path = Preview.Get_Path();
        if (Path.End == EMars_ThrowPreview_End::None || Path.Points.Num() < 2)
        {
            Draw(TArray<FVector>());
            Show(_Ring, false);
            return;
        }

        auto Points = Trim_Start(Path.Points, k_HandClearance);

        // The path ends at the swept sphere's centre; the arrowhead and the rings sit on the surface that sphere touches.
        const auto Lands = Path.End == EMars_ThrowPreview_End::Surface;
        if (Lands && Points.Num() >= 2)
        { Points[Points.Num() - 1] = Path.Landing.Location + Path.Landing.Normal * k_SurfaceLift; }

        Draw(Points);

        if (Lands)
        {
            utils_transform::Request_SetLocation(_RingRoot, FCk_Request_Transform_SetLocation(Path.Landing.Location + Path.Landing.Normal * k_SurfaceLift));
            utils_transform::Request_SetRotation(_RingRoot, FCk_Request_Transform_SetRotation(FRotator::MakeFromZ(Path.Landing.Normal)));
        }

        Show(_Ring, Lands);
    }

    UFUNCTION()
    private void OnAimChanged(FCk_Handle_ThrowPreview InPreview, EMars_ThrowPreview_Aim InAim)
    {
        _Aiming = InAim != EMars_ThrowPreview_Aim::Idle;
        if (_Aiming)
        { return; }

        Draw(TArray<FVector>());
        Show(_Ring, false);
        Show_Power(false);
    }

    private void Draw(const TArray<FVector>& InPoints)
    {
        if (ck::IsValid(_Arc))
        { utils_pmg_polyline::Request_SetPoints(_Arc, FCk_Request_Pmg_Polyline_SetPoints(InPoints)); }
    }

    // The bar shows the share of ThrowSpeed a release now would throw at (HeldItemUse's Get_ThrowPower).
    private void Show_Power(bool InShown)
    {
        Show(_PowerBar, InShown);
        if (InShown == false || ck::Is_NOT_Valid(_PowerBar) || ck::Is_NOT_Valid(_Use))
        { return; }

        auto Mesh = Cast<UStaticMeshComponent>(utils_unreal_component::Get_Component(_PowerBar));
        if (ck::IsValid(Mesh))
        { Mesh.SetCustomPrimitiveDataFloat(0, _Use.Get_ThrowPower()); }
    }

    // Does nothing for a quad left out, or until its component exists.
    private void Show(const FCk_Handle_UnrealComponent& InQuad, bool InShown)
    {
        if (ck::Is_NOT_Valid(InQuad))
        { return; }

        auto Mesh = Cast<UStaticMeshComponent>(utils_unreal_component::Get_Component(InQuad));
        if (ck::IsValid(Mesh) && Mesh.IsVisible() != InShown)
        { Mesh.SetVisibility(InShown); }
    }

    // InPoints with the first InDistance centimetres of their length removed, the cut point interpolated on the segment it
    // falls in; empty when the polyline is no longer than that.
    private TArray<FVector> Trim_Start(const TArray<FVector>& InPoints, float32 InDistance) const
    {
        auto Trimmed = TArray<FVector>();
        auto Walked = 0.0;
        for (int32 Index = 1; Index < InPoints.Num(); ++Index)
        {
            const auto A = InPoints[Index - 1];
            const auto B = InPoints[Index];
            const auto Length = A.Distance(B);
            if (Trimmed.Num() == 0)
            {
                if (Walked + Length <= InDistance)
                {
                    Walked += Length;
                    continue;
                }

                const auto Alpha = Length > 0.0 ? (InDistance - Walked) / Length : 0.0;
                Trimmed.Add(A + (B - A) * Math::Max(Alpha, 0.0));
            }

            Trimmed.Add(B);
        }

        if (Trimmed.Num() < 2)
        { Trimmed.Empty(); }

        return Trimmed;
    }
}

// What Add_Quad made: its scene node and the component on it (unset when the quad was left out).
struct FMars_ThrowPreview_AddedQuad
{
    UPROPERTY()
    FCk_Handle_SceneNode Node;

    UPROPERTY()
    FCk_Handle_UnrealComponent Component;
}
