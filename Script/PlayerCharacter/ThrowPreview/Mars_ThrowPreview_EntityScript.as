// The throw preview's looks: glowing, unlit and drawn over everything - the held item, the gloves and the world - so the
// whole path, its landing and the power always read (Shaders/Looks/ThrowArc.ush, ThrowRing.ush, ThrowPower.ush).
// Translucent because the engine honours a disabled depth test on translucency only. Generated by CkUsf into Mars content
// (console: Ck_Usf_GenerateLooks MarsThrowArc, MarsThrowRing, MarsThrowPower). The generator passes _Parameters to the
// shader positionally, so their order IS the .ush signature after In. Declared here, beside their only consumer: a
// top-level script asset is visible only in its own file.
asset MarsThrowArc of UCkUsf_LookDefinition
{
    _UshIncludePath       = "/Project/Looks/ThrowArc.ush";
    _UshFunctionName      = n"Mars_Look_ThrowArc";
    _Domain               = ECk_Usf_Domain::SurfaceUnlit;
    _BlendMode            = ECk_Usf_BlendMode::Translucent;
    _TwoSided             = true;
    _DisableDepthTest     = true;
    _LookName             = n"MarsThrowArc";
    _GeneratedPackageRoot = "/Game/Mars/Materials/GeneratedLooks";

    FCk_Usf_ParamDesc CoreColor;
    CoreColor._Name          = n"CoreColor";
    CoreColor._Type          = ECk_Usf_ParamType::Vector;
    CoreColor._DefaultVector = FLinearColor(1.0, 0.96, 0.86, 1.0);
    _Parameters.Add(CoreColor);

    FCk_Usf_ParamDesc GlowColor;
    GlowColor._Name          = n"GlowColor";
    GlowColor._Type          = ECk_Usf_ParamType::Vector;
    GlowColor._DefaultVector = FLinearColor(1.0, 0.42, 0.06, 1.0);
    _Parameters.Add(GlowColor);

    FCk_Usf_ParamDesc Brightness;
    Brightness._Name          = n"Brightness";
    Brightness._Type          = ECk_Usf_ParamType::Scalar;
    Brightness._DefaultScalar = 1.6f;
    _Parameters.Add(Brightness);

    FCk_Usf_ParamDesc FadeIn;
    FadeIn._Name          = n"FadeIn";
    FadeIn._Type          = ECk_Usf_ParamType::Scalar;
    FadeIn._DefaultScalar = 30.0f;
    _Parameters.Add(FadeIn);
}

