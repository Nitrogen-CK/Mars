// The throw preview's look: flat white, unlit and two-sided (Shaders/Looks/ThrowArc.ush), drawn over everything - the held
// item, the gloves and the world - so the whole path always reads. Translucent because the engine honours a disabled depth
// test on translucency only. Generated by CkUsf into Mars content (console: Ck_Usf_GenerateLooks MarsThrowArc). The
// generator passes _Parameters to the shader positionally, so their order IS the .ush signature after In. Declared here,
// beside its only consumer: a top-level script asset is visible only in its own file.
asset MarsThrowArc of UCkUsf_LookDefinition
{
    _UshIncludePath       = "/Project/Looks/ThrowArc.ush";
    _UshFunctionName      = n"Mars_Look_ThrowArc";
    _Domain               = ECk_Usf_Domain::SurfaceUnlit;
    _BlendMode            = ECk_Usf_BlendMode::Translucent;
    _TwoSided             = true;
    _DisableDepthTest     = true;
    _LookName             = n"MarsThrowArc";
    _GeneratedPackageRoot = "/Game/Mars/Materials/GeneratedLooks";

    FCk_Usf_ParamDesc Tint;
    Tint._Name          = n"Tint";
    Tint._Type          = ECk_Usf_ParamType::Vector;
    Tint._DefaultVector = FLinearColor(1.0, 1.0, 1.0, 1.0);
    _Parameters.Add(Tint);

    FCk_Usf_ParamDesc Brightness;
    Brightness._Name          = n"Brightness";
    Brightness._Type          = ECk_Usf_ParamType::Scalar;
    Brightness._DefaultScalar = 1.0f;
    _Parameters.Add(Brightness);
}

// What the owning player sees of a throw preview: one white ribbon along the predicted path, ending in an arrowhead on the
// spot it lands. Reads the kernel's path; writes only its own polyline. The path arrives by the kernel's signals, which
// fire in the camera group, so the polyline (drained in FGroup_PostTransform) draws the path of the frame being rendered;
// nothing here ticks.
class UMars_ThrowPreview_EntityScript : UCk_GenericEntityScript_UE
{
    default _Replication = ECk_Replication::DoesNotReplicate;

    UPROPERTY(ExposeOnSpawn)
    FCk_Handle_ThrowPreview Preview;

    // Half the ribbon's width.
    private const float32 k_ArcHalfWidth = 1.5f;
    private const int32 k_ArcMaxPoints = 64;
    private const float32 k_ArrowLength = 16.0f;
    // Half the arrowhead's width at its base.
    private const float32 k_ArrowHalfWidth = 5.0f;
    // The arc starts this far along the path, clear of the gloves and the held item.
    private const float32 k_HandClearance = 25.0f;
    // Off the surface, so the arrowhead does not fight it for depth.
    private const float32 k_SurfaceLift = 0.8f;

    private FCk_Handle_Pmg_Polyline _Arc;
    private bool _Bound = false;

    FCk_Handle_Pmg_Polyline Get_Arc() const { return _Arc; }

    UFUNCTION(BlueprintOverride)
    ECk_EntityScript_ConstructionFlow DoConstruct(FCk_Handle& InHandle)
    {
        if (ck::EnsureIfNot(ck::IsValid(Preview), f"[ThrowPreview] [{InHandle.ToString()}] was spawned without a preview to draw"))
        {
            utils_entity_lifetime::Request_DestroyEntity(InHandle);
            return ECk_EntityScript_ConstructionFlow::Finished;
        }

        auto ArcSpec = FCk_Pmg_Polyline_Spec();
        ArcSpec.Set_Material(Get_LookMaterial(MarsThrowArc));
        ArcSpec.Set_Profile(ECk_Pmg_Polyline_Profile::Ribbon);
        ArcSpec.Set_Radius(k_ArcHalfWidth);
        ArcSpec.Set_MaxPoints(k_ArcMaxPoints);
        ArcSpec.Set_ArrowLength(k_ArrowLength);
        ArcSpec.Set_ArrowRadius(k_ArrowHalfWidth);
        _Arc = utils_pmg_polyline::Create(InHandle, ArcSpec);

        Preview.BindTo_OnPathUpdated(FMars_Delegate_ThrowPreview_OnPathUpdated(this, n"OnPathUpdated"));
        Preview.BindTo_OnAimChanged(FMars_Delegate_ThrowPreview_OnAimChanged(this, n"OnAimChanged"));
        _Bound = true;
        return ECk_EntityScript_ConstructionFlow::Finished;
    }

    UFUNCTION(BlueprintOverride)
    void DoEndPlay(FCk_Handle InHandle)
    {
        if (_Bound && ck::IsValid(Preview))
        {
            Preview.UnbindFrom_OnPathUpdated(FMars_Delegate_ThrowPreview_OnPathUpdated(this, n"OnPathUpdated"));
            Preview.UnbindFrom_OnAimChanged(FMars_Delegate_ThrowPreview_OnAimChanged(this, n"OnAimChanged"));
        }

        _Bound = false;
    }

    // The look's master, or none where nothing can render: a headless boot compiles no look, and CkUsf warns about every
    // master it is asked for there (the polyline is still created and drawn, on the engine's default material). Where
    // something renders, a missing master is an ensure naming the look.
    private TSoftObjectPtr<UMaterialInterface> Get_LookMaterial(UCkUsf_LookDefinition InLook) const
    {
        if (FApp::CanEverRender() == false)
        { return TSoftObjectPtr<UMaterialInterface>(); }

        auto Master = utils_usf::Get_LookMasterMaterial(InLook);
        if (ck::EnsureIfNot(ck::IsValid(Master),
            f"[ThrowPreview] the {InLook.GetName()} look master is not generated - run Ck_Usf_GenerateLooks {InLook.GetName()}"))
        { return TSoftObjectPtr<UMaterialInterface>(); }

        return TSoftObjectPtr<UMaterialInterface>(FSoftObjectPath(Master));
    }

    UFUNCTION()
    private void OnPathUpdated(FCk_Handle_ThrowPreview InPreview)
    {
        const auto Path = Preview.Get_Path();
        if (Path.End == EMars_ThrowPreview_End::None || Path.Points.Num() < 2)
        {
            Draw(TArray<FVector>());
            return;
        }

        auto Points = Trim_Start(Path.Points, k_HandClearance);

        // The path ends at the swept sphere's centre; the arrowhead ends on the surface that sphere touches.
        if (Path.End == EMars_ThrowPreview_End::Surface && Points.Num() >= 2)
        { Points[Points.Num() - 1] = Path.Landing.Location + Path.Landing.Normal * k_SurfaceLift; }

        Draw(Points);
    }

    UFUNCTION()
    private void OnAimChanged(FCk_Handle_ThrowPreview InPreview, EMars_ThrowPreview_Aim InAim)
    {
        if (InAim == EMars_ThrowPreview_Aim::Idle)
        { Draw(TArray<FVector>()); }
    }

    private void Draw(const TArray<FVector>& InPoints)
    {
        if (ck::IsValid(_Arc))
        { utils_pmg_polyline::Request_SetPoints(_Arc, FCk_Request_Pmg_Polyline_SetPoints(InPoints)); }
    }

    // InPoints with the first InDistance centimetres of their length removed, the cut point interpolated on the segment it
    // falls in; empty when the polyline is no longer than that.
    private TArray<FVector> Trim_Start(const TArray<FVector>& InPoints, float32 InDistance) const
    {
        auto Trimmed = TArray<FVector>();
        auto Walked = 0.0;
        for (int32 Index = 1; Index < InPoints.Num(); ++Index)
        {
            const auto A = InPoints[Index - 1];
            const auto B = InPoints[Index];
            const auto Length = A.Distance(B);
            if (Trimmed.Num() == 0)
            {
                if (Walked + Length <= InDistance)
                {
                    Walked += Length;
                    continue;
                }

                const auto Alpha = Length > 0.0 ? (InDistance - Walked) / Length : 0.0;
                Trimmed.Add(A + (B - A) * Math::Max(Alpha, 0.0));
            }

            Trimmed.Add(B);
        }

        if (Trimmed.Num() < 2)
        { Trimmed.Empty(); }

        return Trimmed;
    }
}
