// What the owning player sees of a throw preview: a dashed arc along the predicted path and a ring where it lands. Reads
// the kernel's path; writes only its own two polylines. The path arrives by the kernel's signals, which fire in the camera
// group, so the polylines (drained in FGroup_PostTransform) draw the path of the frame being rendered; nothing here ticks.
class UMars_ThrowPreview_EntityScript : UCk_GenericEntityScript_UE
{
    default _Replication = ECk_Replication::DoesNotReplicate;

    UPROPERTY(ExposeOnSpawn)
    FCk_Handle_ThrowPreview Preview;

    private const float32 k_ArcRadius = 1.2f;
    private const int32 k_ArcSides = 6;
    private const int32 k_ArcMaxPoints = 64;
    // The arc starts this far along the path, clear of the gloves and the held item.
    private const float32 k_HandClearance = 25.0f;

    private const float32 k_RingTubeRadius = 1.0f;
    private const int32 k_RingSides = 6;
    // The ring's radius: the swept sphere's times this, never less than the minimum.
    private const float32 k_RingRadiusPerCastRadius = 1.6f;
    private const float32 k_RingRadiusMin = 14.0f;
    // Off the surface, so the ring does not fight it for depth.
    private const float32 k_RingLift = 0.8f;
    // 32 segments, closed: the last point is the first.
    private const int32 k_RingPoints = 33;

    private FCk_Handle_Pmg_Polyline _Arc;
    private FCk_Handle_Pmg_Polyline _Ring;
    private bool _Bound = false;

    FCk_Handle_Pmg_Polyline Get_Arc() const { return _Arc; }

    FCk_Handle_Pmg_Polyline Get_Ring() const { return _Ring; }

    UFUNCTION(BlueprintOverride)
    ECk_EntityScript_ConstructionFlow DoConstruct(FCk_Handle& InHandle)
    {
        if (ck::EnsureIfNot(ck::IsValid(Preview), f"[ThrowPreview] [{InHandle.ToString()}] was spawned without a preview to draw"))
        {
            utils_entity_lifetime::Request_DestroyEntity(InHandle);
            return ECk_EntityScript_ConstructionFlow::Finished;
        }

        auto ArcSpec = FCk_Pmg_Polyline_Spec();
        ArcSpec.Set_Material(Get_LookMaterial(MarsThrowArc));
        ArcSpec.Set_Radius(k_ArcRadius);
        ArcSpec.Set_Sides(k_ArcSides);
        ArcSpec.Set_MaxPoints(k_ArcMaxPoints);
        _Arc = utils_pmg_polyline::Create(InHandle, ArcSpec);

        auto RingSpec = FCk_Pmg_Polyline_Spec();
        RingSpec.Set_Material(Get_LookMaterial(MarsThrowRing));
        RingSpec.Set_Radius(k_RingTubeRadius);
        RingSpec.Set_Sides(k_RingSides);
        RingSpec.Set_MaxPoints(k_RingPoints);
        _Ring = utils_pmg_polyline::Create(InHandle, RingSpec);

        Preview.BindTo_OnPathUpdated(FMars_Delegate_ThrowPreview_OnPathUpdated(this, n"OnPathUpdated"));
        Preview.BindTo_OnAimChanged(FMars_Delegate_ThrowPreview_OnAimChanged(this, n"OnAimChanged"));
        _Bound = true;
        return ECk_EntityScript_ConstructionFlow::Finished;
    }

    UFUNCTION(BlueprintOverride)
    void DoEndPlay(FCk_Handle InHandle)
    {
        if (_Bound && ck::IsValid(Preview))
        {
            Preview.UnbindFrom_OnPathUpdated(FMars_Delegate_ThrowPreview_OnPathUpdated(this, n"OnPathUpdated"));
            Preview.UnbindFrom_OnAimChanged(FMars_Delegate_ThrowPreview_OnAimChanged(this, n"OnAimChanged"));
        }

        _Bound = false;
    }

    // The look's master, or none where nothing can render: a headless boot compiles no look, and CkUsf warns about every
    // master it is asked for there (the polylines are still created and drawn, on the engine's default material). Where
    // something renders, a missing master is an ensure naming the look.
    private TSoftObjectPtr<UMaterialInterface> Get_LookMaterial(UCkUsf_LookDefinition InLook) const
    {
        if (FApp::CanEverRender() == false)
        { return TSoftObjectPtr<UMaterialInterface>(); }

        auto Master = utils_usf::Get_LookMasterMaterial(InLook);
        if (ck::EnsureIfNot(ck::IsValid(Master),
            f"[ThrowPreview] the {InLook.GetName()} look master is not generated - run Ck_Usf_GenerateLooks {InLook.GetName()}"))
        { return TSoftObjectPtr<UMaterialInterface>(); }

        return TSoftObjectPtr<UMaterialInterface>(FSoftObjectPath(Master));
    }

    UFUNCTION()
    private void OnPathUpdated(FCk_Handle_ThrowPreview InPreview)
    {
        const auto Path = Preview.Get_Path();
        if (Path.End == EMars_ThrowPreview_End::None || Path.Points.Num() < 2)
        {
            Clear();
            return;
        }

        Draw(_Arc, Trim_Start(Path.Points, k_HandClearance));

        if (Path.End != EMars_ThrowPreview_End::Surface)
        {
            Draw(_Ring, TArray<FVector>());
            return;
        }

        const auto Radius = Math::Max(k_RingRadiusMin, Path.CastRadius * k_RingRadiusPerCastRadius);
        Draw(_Ring, Make_Ring(Path.Landing, Radius));
    }

    UFUNCTION()
    private void OnAimChanged(FCk_Handle_ThrowPreview InPreview, EMars_ThrowPreview_Aim InAim)
    {
        if (InAim == EMars_ThrowPreview_Aim::Idle)
        { Clear(); }
    }

    private void Clear()
    {
        Draw(_Arc, TArray<FVector>());
        Draw(_Ring, TArray<FVector>());
    }

    private void Draw(FCk_Handle_Pmg_Polyline InPolyline, const TArray<FVector>& InPoints)
    {
        if (ck::IsValid(InPolyline))
        { utils_pmg_polyline::Request_SetPoints(InPolyline, FCk_Request_Pmg_Polyline_SetPoints(InPoints)); }
    }

    // InPoints with the first InDistance centimetres of their length removed, the cut point interpolated on the segment it
    // falls in; empty when the polyline is no longer than that.
    private TArray<FVector> Trim_Start(const TArray<FVector>& InPoints, float32 InDistance) const
    {
        auto Trimmed = TArray<FVector>();
        auto Walked = 0.0;
        for (int32 Index = 1; Index < InPoints.Num(); ++Index)
        {
            const auto A = InPoints[Index - 1];
            const auto B = InPoints[Index];
            const auto Length = A.Distance(B);
            if (Trimmed.Num() == 0)
            {
                if (Walked + Length <= InDistance)
                {
                    Walked += Length;
                    continue;
                }

                const auto Alpha = Length > 0.0 ? (InDistance - Walked) / Length : 0.0;
                Trimmed.Add(A + (B - A) * Math::Max(Alpha, 0.0));
            }

            Trimmed.Add(B);
        }

        if (Trimmed.Num() < 2)
        { Trimmed.Empty(); }

        return Trimmed;
    }

    // k_RingPoints points on a circle of InRadius in the plane of the landing's normal, centred k_RingLift off the surface;
    // the last point is the first.
    private TArray<FVector> Make_Ring(const FMars_ThrowPreview_Landing& InLanding, float32 InRadius) const
    {
        auto Normal = InLanding.Normal.GetSafeNormal();
        if (Normal.IsNearlyZero())
        { Normal = FVector::UpVector; }

        // Any axis in the plane: the normal crossed with whichever world axis is furthest from it.
        const auto Reference = Math::Abs(Normal.Z) < 0.9 ? FVector::UpVector : FVector::ForwardVector;
        const auto AxisU = Normal.CrossProduct(Reference).GetSafeNormal();
        const auto AxisV = Normal.CrossProduct(AxisU);
        const auto Centre = InLanding.Location + Normal * k_RingLift;

        auto Points = TArray<FVector>();
        const auto Segments = k_RingPoints - 1;
        for (int32 Index = 0; Index < Segments; ++Index)
        {
            const auto Angle = 2.0 * PI * float64(Index) / float64(Segments);
            Points.Add(Centre + (AxisU * Math::Cos(Angle) + AxisV * Math::Sin(Angle)) * InRadius);
        }

        // A copy: AngelScript refuses to add an element of the array to itself.
        const auto First = Points[0];
        Points.Add(First);
        return Points;
    }
}
