    Tint._Type          = ECk_Usf_ParamType::Vector;
    Tint._DefaultVector = FLinearColor(1.0, 0.82, 0.45, 1.0);
    _Parameters.Add(Tint);

    FCk_Usf_ParamDesc Brightness;
    Brightness._Name          = n"Brightness";
    Brightness._Type          = ECk_Usf_ParamType::Scalar;
    Brightness._DefaultScalar = 3.0f;
    _Parameters.Add(Brightness);

    FCk_Usf_ParamDesc Coverage;
    Coverage._Name          = n"Coverage";
    Coverage._Type          = ECk_Usf_ParamType::Scalar;
    Coverage._DefaultScalar = 0.9f;
    _Parameters.Add(Coverage);

    FCk_Usf_ParamDesc DashLengthCm;
