// The throw preview's two looks: marching dashes along a tube (Shaders/Looks/ThrowArc.ush), generated by CkUsf into Mars
// content (console: Ck_Usf_GenerateLooks MarsThrowArc, Ck_Usf_GenerateLooks MarsThrowRing). The generator passes
// _Parameters to the shader positionally, so their order IS the .ush signature after In. Coverage is the look's overall
// opacity: "Opacity" is the generated Custom node's own output name. Declared here, beside their only consumer: a
// top-level script asset is visible only in its own file.
asset MarsThrowArc of UCkUsf_LookDefinition
{
    _UshIncludePath       = "/Project/Looks/ThrowArc.ush";
    _UshFunctionName      = n"Mars_Look_ThrowArc";
    _Domain               = ECk_Usf_Domain::SurfaceUnlit;
    _BlendMode            = ECk_Usf_BlendMode::Translucent;
    _LookName             = n"MarsThrowArc";
    _GeneratedPackageRoot = "/Game/Mars/Materials/GeneratedLooks";

    FCk_Usf_ParamDesc Tint;
    Tint._Name          = n"Tint";
    Tint._Type          = ECk_Usf_ParamType::Vector;
    Tint._DefaultVector = FLinearColor(1.0, 0.82, 0.45, 1.0);
    _Parameters.Add(Tint);

    FCk_Usf_ParamDesc Brightness;
    Brightness._Name          = n"Brightness";
    Brightness._Type          = ECk_Usf_ParamType::Scalar;
    Brightness._DefaultScalar = 3.0f;
    _Parameters.Add(Brightness);

    FCk_Usf_ParamDesc Coverage;
    Coverage._Name          = n"Coverage";
    Coverage._Type          = ECk_Usf_ParamType::Scalar;
    Coverage._DefaultScalar = 0.85f;
    _Parameters.Add(Coverage);

    FCk_Usf_ParamDesc DashLengthCm;
    DashLengthCm._Name          = n"DashLengthCm";
    DashLengthCm._Type          = ECk_Usf_ParamType::Scalar;
    DashLengthCm._DefaultScalar = 18.0f;
    _Parameters.Add(DashLengthCm);

    FCk_Usf_ParamDesc DashFill;
    DashFill._Name          = n"DashFill";
    DashFill._Type          = ECk_Usf_ParamType::Scalar;
    DashFill._DefaultScalar = 0.6f;
    _Parameters.Add(DashFill);

    FCk_Usf_ParamDesc ScrollCmPerSecond;
    ScrollCmPerSecond._Name          = n"ScrollCmPerSecond";
    ScrollCmPerSecond._Type          = ECk_Usf_ParamType::Scalar;
    ScrollCmPerSecond._DefaultScalar = 40.0f;
    _Parameters.Add(ScrollCmPerSecond);

    // The share of the path at each end over which the dashes fade in and out.
    FCk_Usf_ParamDesc EndFade;
    EndFade._Name          = n"EndFade";
    EndFade._Type          = ECk_Usf_ParamType::Scalar;
    EndFade._DefaultScalar = 0.08f;
    _Parameters.Add(EndFade);
}

asset MarsThrowRing of UCkUsf_LookDefinition
{
    _UshIncludePath       = "/Project/Looks/ThrowArc.ush";
    _UshFunctionName      = n"Mars_Look_ThrowArc";
    _Domain               = ECk_Usf_Domain::SurfaceUnlit;
