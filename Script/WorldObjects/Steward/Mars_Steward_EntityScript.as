class UMars_Steward_EntityScript : UCk_GenericEntityScript_UE
{
    default _ShowInPlaceActors = true;
    default _Replication = ECk_Replication::DoesNotReplicate;

    UPROPERTY(ExposeOnSpawn)
    FTransform SpawnTransform = FTransform::Identity;

    // Opt-in camp assembly; existing sandbox Stewards retain their original idle and maw.
    UPROPERTY(ExposeOnSpawn)
    bool PresentsServices = false;

    private UMars_Steward_Config _Config = mars::Mars_Steward_Config;

    // The scene node the body mesh sits on (the config's MeshOffset and Scale under the root).
    private FCk_Handle_Transform _BodyNode;
    private FCk_Handle_UnrealComponent _Body;
    private FCk_Handle_Eyes _Eyes;

    private FCk_Handle_Transform _Root;
    // Rides the head bone; invalid until the body exists (ConstructEyes).
    private FCk_Handle_Transform _Face;

    private FCk_Handle_Devour _Devour;
    // The node a held victim's view is given to (the Devour spec's View), under the root.
    private FCk_Handle_SceneNode _ViewNode;
    // The victim's own view when it was seized: where the View node starts from.
    private FTransform _ViewStart = FTransform::Identity;
    // Ticks only while a victim is held or the plate is lifting.
    private FCk_Handle_Timer _MawTick;
    // The face plate in the victim's view; invalid before Blink, once it has lifted, and on a machine that is not the
    // victim's.
    private FCk_Handle_UnrealComponent _MawPlate;
    // Seconds of the plate's lift left (FadeBackSeconds down to 0); 0 while it is not lifting.
    private float32 _MawLiftSeconds = 0.0f;

    // Custom primitive data slots of the MarsStewardMaw look (see the asset above).
    private const int32 MawSlot_Face = 0;
    private const int32 MawSlot_Jaws = 4;
    private const int32 MawSlot_Color = 8;
    private const int32 MawSlot_Dread = 12;

    UFUNCTION(BlueprintOverride)
    ECk_EntityScript_ConstructionFlow DoConstruct(FCk_Handle& InHandle)
    {
        auto Root = utils_transform::Add(InHandle, SpawnTransform, ECk_Replication::DoesNotReplicate);
        _Root = Root;

        const auto Validation = _Config.Validate();
        if (ck::EnsureIfNot(Validation.IsValid(), f"[Steward] [{InHandle.ToString()}] rejected its config: {Validation.Get_Error()}"))
        { return ECk_EntityScript_ConstructionFlow::Finished; }

        if (PresentsServices)
        {
            const auto ServiceValidation = mars::Mars_StewardService_Config.Validate();
            if (ck::EnsureIfNot(ServiceValidation.IsValid(), f"[Steward] rejected service presentation: {ServiceValidation.Get_Error()}"))
            { return ECk_EntityScript_ConstructionFlow::Finished; }
            utils_camp_ui_station::Create(Root, EMars_CampStation::Contracts,
                FVector(50.0, 55.0, 150.0), FTransform(FVector(25.0, 0.0, 150.0)));
        }

        utils_entity_tag::Add(InHandle, constants_steward::k_EntityTag);

        const auto& Body = _Config.Body;
        const auto BodyTransform = FTransform(Body.MeshOffset.Rotator(), Body.MeshOffset.GetLocation(), FVector(Body.Scale, Body.Scale, Body.Scale));
        _BodyNode = utils_scene_node::Create(Root, BodyTransform).As_Transform();
        utils_handle::Set_DebugName(_BodyNode.H(), n"Steward.Body");

        // The component is created later; the mesh, the idle and the face are set up once it exists (OnBodyAdded).
        const auto ComponentParams = utils_unreal_component::Make_Params(USkeletalMeshComponent, ECk_UnrealComponent_TickPolicy::DoNotTick, n"Steward_Body");
        _Body = utils_unreal_component::Add(_BodyNode.H(), ComponentParams);
        utils_unreal_component::BindTo_OnAdded(_Body, FCk_Delegate_UnrealComponent_OnAdded(this, n"OnBodyAdded"));

        _ViewNode = utils_scene_node::Create(Root, FTransform::Identity);
        utils_handle::Set_DebugName(_ViewNode.H(), n"Steward.MawView");

        auto DevourSpec = FMars_Devour_Spec();
        DevourSpec.Timing = _Config.Maw.Timing;
        DevourSpec.View = _ViewNode.As_Transform();
        _Devour = utils_devour::Add(InHandle, DevourSpec);

        auto FailSinkSpec = FMars_MechanismSink_Spec();
        FailSinkSpec.InputChannels.Add(GameplayTags::ResolveGameplayTag(constants_steward::k_ServiceFailedChannel));
        auto FailSink = utils_mechanism_sink::Add(InHandle, FailSinkSpec);
        if (ck::IsValid(FailSink))
        { FailSink.BindTo_OnPoweredChanged(FMars_Delegate_MechanismSink_OnPoweredChanged(this, n"OnServiceFailedChanged")); }

        return ECk_EntityScript_ConstructionFlow::Finished;
    }

    UFUNCTION(BlueprintOverride)
    void DoBeginPlay(FCk_Handle InHandle)
    {
        if (ck::Is_NOT_Valid(_Devour))
        { return; }

        _Devour.BindTo_OnPhaseChanged(FMars_Delegate_Devour_OnPhaseChanged(this, n"OnDevourPhaseChanged"));
        _Devour.BindTo_OnEnded(FMars_Delegate_Devour_OnEnded(this, n"OnDevourEnded"));
    }

    UFUNCTION(BlueprintOverride)
    void DoEndPlay(FCk_Handle InHandle)
    {
        if (ck::IsValid(_Devour))
        {
            _Devour.UnbindFrom_OnPhaseChanged(FMars_Delegate_Devour_OnPhaseChanged(this, n"OnDevourPhaseChanged"));
            _Devour.UnbindFrom_OnEnded(FMars_Delegate_Devour_OnEnded(this, n"OnDevourEnded"));
        }

        StopMawTick();
        RemoveMawPlate();
    }

    //----------------------------------------------------------------------------------------------------------------------
    // Handlers
    //----------------------------------------------------------------------------------------------------------------------

    UFUNCTION()
    private void OnBodyAdded(FCk_Handle_UnrealComponent InHandle)
    {
        auto Mesh = Cast<USkeletalMeshComponent>(utils_unreal_component::Get_Component(InHandle));
        if (ck::EnsureIfNot(ck::IsValid(Mesh), f"[Steward] [{_BodyNode.ToString()}] got no USkeletalMeshComponent for its body"))
        { return; }

        const auto& Body = _Config.Body;

        // Nothing on the steward collides yet.
        Mesh.SetCollisionEnabled(ECollisionEnabled::NoCollision);
        const auto BodyMesh = PresentsServices ? mars::Mars_StewardService_Config.Parchment.BodyMesh : Body.Mesh;
        Mesh.SetSkeletalMeshAsset(System::LoadAsset_Blocking(BodyMesh));

        const auto Animation = PresentsServices ? mars::Mars_StewardService_Config.Parchment.PresentLoop : Body.Idle;
        if (Animation.IsNull() == false)
        {
            auto LoadedAnimation = System::LoadAsset_Blocking(Animation);
            if (ck::EnsureIfNot(ck::IsValid(LoadedAnimation), "[Steward] configured body animation did not load"))
            { return; }
            const auto Looping = true;
            Mesh.PlayAnimation(LoadedAnimation, Looping);
        }

        ConstructEyes(Mesh);
        if (PresentsServices)
        { ConstructServiceParchment(); }
    }

    private void ConstructServiceParchment()
    {
        const auto& Parchment = mars::Mars_StewardService_Config.Parchment;
        auto Mesh = System::LoadAsset_Blocking(Parchment.Mesh);
        if (ck::EnsureIfNot(ck::IsValid(Mesh), "[Steward] service parchment mesh did not load"))
        { return; }
        _Root.Add_MeshPart(this, FMars_MeshPart(Parchment.Offset, Mesh, nullptr,
            collision::profile::NoCollision, n"Steward_ServiceParchment"));
    }

    //----------------------------------------------------------------------------------------------------------------------
    // The eyes: a face node following the head bone carries Gaze (looking at players' heads) and Eyes, which write their
    // values into the body's custom primitive data; the body's eye slot draws them.
    //----------------------------------------------------------------------------------------------------------------------

    // Where cosmetics cannot run (a dedicated server) the face is only its node and the eyes' logic: no look, no gaze.
    private void ConstructEyes(USkeletalMeshComponent InMesh)
    {
        const auto& FaceSpec = _Config.Face;
        if (ck::EnsureIfNot(InMesh.DoesSocketExist(FaceSpec.Bone),
            f"[Steward] [{_BodyNode.ToString()}] the body mesh has no [{FaceSpec.Bone}] bone for the eyes"))
        { return; }

        auto FaceNode = utils_scene_node::CreateAndAttachToUnrealMesh(_BodyNode, InMesh, FaceSpec.Bone, FaceSpec.Offset);
        utils_handle::Set_DebugName(FaceNode.H(), n"Steward.Face");
        auto Face = FaceNode.As_Transform();
        _Face = Face;

        auto EyesSlot = ck::INDEX_NONE();
        if (utils_net::Get_CanExecuteCosmeticEvents(Face))
        {
            EyesSlot = SetUpEyesSlot(InMesh, FaceSpec.EyesSlot);

            auto GazeSpec = FMars_Gaze_Spec();
            GazeSpec.DetectionFilter.AddTag(GameplayTags::Probe_Mars_Player);
            GazeSpec.AimPoint = GameplayTags::AttachPoint_Mars_Head;
            GazeSpec.RangeCm = _Config.Gaze.RangeCm;
            GazeSpec.ConeHalfAngleDeg = _Config.Gaze.ConeHalfAngleDeg;
            utils_gaze::Add(Face, GazeSpec);
        }

        _Eyes = utils_eyes::Add(Face, _Config.Eyes);
        if (ck::IsValid(_Eyes) && EyesSlot != ck::INDEX_NONE())
        { _Eyes.Request_SetPlatePrimitive(FMars_Request_Eyes_SetPlatePrimitive(InMesh, EyesSlot)); }
    }

    // Puts the eye-plate look on the body's eye slot and returns the slot's index. INDEX_NONE where nothing can render
    // (a headless boot has no compiled look, and CkUsf warns about every one it is asked for), and - after an ensure -
    // when the body mesh has no such slot or the MarsEyePlate look master is not generated; the eyes then have logic
    // but nothing to draw on.
    private int32 SetUpEyesSlot(USkeletalMeshComponent InMesh, FName InSlotName)
    {
        if (FApp::CanEverRender() == false)
        { return ck::INDEX_NONE(); }

        const auto SlotIndex = InMesh.GetMaterialIndex(InSlotName);
        if (ck::EnsureIfNot(SlotIndex != ck::INDEX_NONE(),
            f"[Steward] [{_BodyNode.ToString()}] the body mesh has no [{InSlotName}] material slot for the eyes - re-export it from build_steward.py"))
        { return ck::INDEX_NONE(); }

        auto LookMaster = utils_usf::Get_LookMasterMaterial(utils_eyes::Look_EyePlate());
        if (ck::EnsureIfNot(ck::IsValid(LookMaster),
            "[Steward] the MarsEyePlate look master is not generated - run Ck_Usf_GenerateLooks MarsEyePlate"))
        { return ck::INDEX_NONE(); }

        InMesh.SetMaterial(SlotIndex, LookMaster);
        return SlotIndex;
    }

    //----------------------------------------------------------------------------------------------------------------------
    // The service failing. The channel rising is the whole event: the steward takes one victim per rise, and a rise while
    // it already holds one is lost (the kernel takes one victim at a time).
    //----------------------------------------------------------------------------------------------------------------------

    UFUNCTION()
    private void OnServiceFailedChanged(FCk_Handle_MechanismSink InSink, EMars_MechanismSink_Power InPower)
    {
        if (InPower != EMars_MechanismSink_Power::Powered || ck::Is_NOT_Valid(_Devour))
        { return; }

        const auto Victim = Find_NearestVictim();
        if (ck::Is_NOT_Valid(Victim))
        { return; }

        _Devour.Request_Begin(FMars_Request_Devour_Begin(Victim));
    }

    // The nearest entity carrying the victim tag that the kernel would take now; invalid when there is none.
    private FCk_Handle Find_NearestVictim()
    {
        const auto Here = utils_transform::Get_EntityCurrentLocation(_Root);
        auto Nearest = FCk_Handle();
        auto NearestDistance = 0.0;
        for (auto Candidate : utils_entity_tag::ForEach_Entity(_Root.H(), constants_steward::k_VictimTag))
        {
            const auto Transform = Candidate.As_Transform(ECk_SanityCheck::UnChecked);
            if (ck::Is_NOT_Valid(Transform) || _Devour.Get_CanSeize(Candidate) == false)
            { continue; }

            const auto Distance = utils_transform::Get_EntityCurrentLocation(Transform).Distance(Here);
            if (ck::Is_NOT_Valid(Nearest) || Distance < NearestDistance)
            {
                Nearest = Candidate;
                NearestDistance = Distance;
            }
        }

        return Nearest;
    }

    //----------------------------------------------------------------------------------------------------------------------
    // Devouring. The Devour feature decides the phase and how far through it is; everything below only shows it.
    //----------------------------------------------------------------------------------------------------------------------

    UFUNCTION()
    private void OnDevourPhaseChanged(FCk_Handle_Devour InDevour, EMars_Devour_Phase InPhase)
    {
        if (InPhase == EMars_Devour_Phase::Seize)
        {
            _ViewStart = Get_VictimView(InDevour.Get_Victim());
            Update_MawView(InPhase, 0.0f);
            StartMawTick();
        }
        else if (InPhase == EMars_Devour_Phase::Blink)
        {
            BuildMawPlate(InDevour.Get_Victim());
        }
        else if (InPhase == EMars_Devour_Phase::Bite)
        {
            if (ck::IsValid(_Eyes))
            { _Eyes.Request_SetStateExpression(FMars_Request_Eyes_SetStateExpression(utils_eyes::Expression_Evil().Def)); }
        }
    }

    // A run that completed ends in black: the victim's view is its own again under the plate, which stays black and
    // lifts over FadeBackSeconds (OnMawTick). A cancelled run takes the plate away at once.
    UFUNCTION()
    private void OnDevourEnded(FCk_Handle_Devour InDevour, FCk_Handle InVictim, EMars_Devour_End InEnd)
    {
        if (ck::IsValid(_Eyes))
        { _Eyes.Request_ClearExpression(FMars_Request_Eyes_ClearExpression(EMars_Eyes_Layer::State)); }

        const auto LiftSeconds = _Config.Maw.FadeBackSeconds;
        if (ck::IsValid(_MawPlate) && InEnd == EMars_Devour_End::Completed && LiftSeconds > 0.0f)
        {
            _MawLiftSeconds = LiftSeconds;
            Push_MawFrame(FMars_Steward_MawFrame());
            return;
        }

        StopMawTick();
        RemoveMawPlate();
    }

    UFUNCTION()
    private void OnMawTick(FCk_Handle_Timer InTimer, FCk_Chrono InChrono, FCk_Time InDeltaT)
    {
        if (ck::IsValid(_Devour) && _Devour.Get_IsActive())
        {
            const auto Phase = _Devour.Get_Phase();
            const auto Alpha = _Devour.Get_PhaseAlpha();
            Update_MawView(Phase, Alpha);

            if (ck::IsValid(_MawPlate))
            { Push_MawFrame(_Config.Maw.Get_Frame(Phase, Alpha)); }
            return;
        }

        // The plate lifting off a released victim's view.
        _MawLiftSeconds -= float32(InDeltaT.Get_Seconds());
        if (_MawLiftSeconds <= 0.0f || ck::Is_NOT_Valid(_MawPlate))
        {
            StopMawTick();
            RemoveMawPlate();
            return;
        }

        auto Frame = FMars_Steward_MawFrame();
        Frame.Veil = _MawLiftSeconds / _Config.Maw.FadeBackSeconds;
        Push_MawFrame(Frame);
    }

    // A victim seized while the last one's plate is still lifting takes over: that plate goes at once.
    private void StartMawTick()
    {
        if (_MawLiftSeconds > 0.0f)
        { RemoveMawPlate(); }

        if (ck::IsValid(_MawTick))
        { return; }

        _MawTick = utils_timer::Create_Tick(_Root.H(), FCk_Delegate_Timer(this, n"OnMawTick"));
    }

    private void StopMawTick()
    {
        if (ck::IsValid(_MawTick))
        { utils_entity_lifetime::Request_DestroyEntity(_MawTick.H()); }

        _MawTick = FCk_Handle_Timer();
    }

    // The victim's view as it is now: its player viewpoint's view anchor, or the victim's own transform when it has no
    // viewpoint (anything that is not a player), or the root's when it has neither.
    private FTransform Get_VictimView(FCk_Handle InVictim) const
    {
        // A by-value handle is read-only; the copy is the same entity.
        auto Victim = InVictim;
        const auto Viewpoint = Victim.As_PlayerViewpoint(ECk_SanityCheck::UnChecked);
        if (ck::IsValid(Viewpoint) && ck::IsValid(Viewpoint.Get_Viewpoint()))
        { return utils_transform::Get_EntityCurrentTransform(Viewpoint.Get_Viewpoint()); }

        const auto Transform = Victim.As_Transform(ECk_SanityCheck::UnChecked);
        if (ck::IsValid(Transform))
        { return utils_transform::Get_EntityCurrentTransform(Transform); }

        return utils_transform::Get_EntityCurrentTransform(_Root);
    }

    // The face node's world transform (+X out of the face). Before the body exists it stands in for it: the root, the
    // reference pose's eye height up.
    private FTransform Get_FaceWorld() const
    {
        if (ck::IsValid(_Face))
        { return utils_transform::Get_EntityCurrentTransform(_Face); }

        const auto EyeHeight = float64(_Config.Body.ReferenceEyeHeightCm * _Config.Body.Scale);
        return FTransform(FRotator::ZeroRotator, FVector(0.0, 0.0, EyeHeight)) * utils_transform::Get_EntityCurrentTransform(_Root);
    }

    // Moves the View node: Seize turns the victim's view to the face where it stands, Lift carries it to the bite point
    // (Bite.DistanceCm out of the face, looking back at it), and it stays there.
    private void Update_MawView(EMars_Devour_Phase InPhase, float32 InAlpha)
    {
        const auto FaceWorld = Get_FaceWorld();
        const auto FaceLocation = FaceWorld.GetLocation();
        const auto FaceForward = FaceWorld.GetRotation().GetForwardVector();
        const auto BiteLocation = FaceLocation + FaceForward * _Config.Maw.Bite.DistanceCm;
        const auto BiteRotation = FRotator::MakeFromXZ(FaceForward * -1.0, FVector::UpVector).Quaternion();

        const auto StartLocation = _ViewStart.GetLocation();
        const auto ToFace = (FaceLocation - StartLocation).GetSafeNormal();
        const auto FacingRotation = FRotator::MakeFromXZ(ToFace, FVector::UpVector).Quaternion();

        auto Location = BiteLocation;
        auto Rotation = BiteRotation;
        if (InPhase == EMars_Devour_Phase::Seize)
        {
            Location = StartLocation;
            Rotation = FQuat::Slerp(_ViewStart.GetRotation(), FacingRotation, float(Math::SmoothStep(0.0f, 1.0f, InAlpha)));
        }
        else if (InPhase == EMars_Devour_Phase::Lift)
        {
            const auto Eased = float(Math::SmoothStep(0.0f, 1.0f, InAlpha));
            Location = StartLocation + (BiteLocation - StartLocation) * Eased;
            Rotation = FQuat::Slerp(FacingRotation, BiteRotation, Eased);
        }

        const auto ViewWorld = FTransform(Rotation.Rotator(), Location);
        const auto Offset = ViewWorld.GetRelativeTransform(utils_transform::Get_EntityCurrentTransform(_Root));
        utils_scene_node::Request_UpdateOffset(_ViewNode, FCk_Request_SceneNode_UpdateRelativeTransform(Offset));
    }

    // The plate hangs off the victim's view anchor, so it is in the view whatever the view does. Only the victim's own
    // machine builds it, and only where something can render (a headless boot has no compiled look, and CkUsf warns
    // about every one it is asked for). Taking the engine plane's face as local +Z with U along local +X and V along
    // local +Y: the yaw and roll turn its face back to the eye (the anchor's -X) with U along +Y (the view's right) and V
    // down.
    private void BuildMawPlate(FCk_Handle InVictim)
    {
        if (ck::IsValid(_MawPlate) || FApp::CanEverRender() == false)
        { return; }

        if (utils_net::Get_IsEntityLocallyControlled_ByPlayer(InVictim) != ECk_Utils_Net_IsLocallyControlled_Result::IsLocallyControlled)
        { return; }

        // A by-value handle is read-only; the copy is the same entity.
        auto Victim = InVictim;
        const auto Viewpoint = Victim.As_PlayerViewpoint(ECk_SanityCheck::UnChecked);
        if (ck::Is_NOT_Valid(Viewpoint))
        { return; }

        auto LookMaster = utils_usf::Get_LookMasterMaterial(MarsStewardMaw);
        if (ck::EnsureIfNot(ck::IsValid(LookMaster),
            "[Steward] the MarsStewardMaw look master is not generated - run Ck_Usf_GenerateLooks MarsStewardMaw"))
        { return; }

        const auto& Maw = _Config.Maw;
        const auto Scale = Maw.Plate.SizeCm / 100.0;
        auto Part = FMars_MeshPart(
            FTransform(FRotator(0.0, 90.0, 90.0), FVector(Maw.Plate.DistanceCm, 0.0, 0.0), FVector(Scale, Scale, 1.0)),
            engine::load::Plane(), LookMaster, collision::profile::NoCollision, n"Steward_MawPlate");
        Part.CastShadow = false;
        Part.ReceivesDecals = false;

        auto Anchor = Viewpoint.Get_Viewpoint();
        _MawPlate = Anchor.Add_MeshPart(this, Part);

        const auto& Color = _Config.Eyes.Style.Color;
        Push_MawGroup(MawSlot_Color, FLinearColor(Color.R, Color.G, Color.B, Color.A));
        Push_MawFrame(FMars_Steward_MawFrame());
    }

    private void RemoveMawPlate()
    {
        if (ck::IsValid(_MawPlate))
        { utils_entity_lifetime::Request_DestroyEntity(utils_unreal_component::Get_OwningEntity(_MawPlate)); }

        _MawPlate = FCk_Handle_UnrealComponent();
        _MawLiftSeconds = 0.0f;
    }

    // Span makes the look's coordinates +-1 at the view's left and right edges: the plate's width over its distance times
    // the tangent of half the horizontal field of view (the player viewpoint's, 90 degrees: tangent 1).
    private void Push_MawFrame(const FMars_Steward_MawFrame& InFrame)
    {
        const auto& Maw = _Config.Maw;
        const auto Span = Maw.Plate.SizeCm / Maw.Plate.DistanceCm;
        Push_MawGroup(MawSlot_Face, FLinearColor(InFrame.Strength, InFrame.EyeOpen, InFrame.Evil, InFrame.Mouth));
        Push_MawGroup(MawSlot_Jaws, FLinearColor(InFrame.Jaw, InFrame.Zoom, Span, InFrame.Veil));
        Push_MawGroup(MawSlot_Dread, FLinearColor(InFrame.Heat, InFrame.Shake, InFrame.TiltRadians, 0.0f));
    }

    // Four consecutive floats from InSlot; the request applies them once the plate's component exists.
    private void Push_MawGroup(int32 InSlot, FLinearColor InFloats)
    {
        if (ck::Is_NOT_Valid(_MawPlate))
        { return; }

        const auto Data = FCk_CustomPrimitiveData(InSlot, FCk_CustomPrimitiveData_Value(InFloats));
        utils_unreal_component::Request_SetCustomPrimitiveData(_MawPlate, FCk_Request_UnrealComponent_SetCustomPrimitiveData(Data));
    }
}
