// The service steward (+X is its facing): a 2.9 m figure standing where it is placed, breathing through its idle loop,
// its two eyes blinking and following the nearest player in front of it. The same eyes tech as the chef: the body
// mesh's face plate is an eye-plate slot, and a face node riding the head bone composes Gaze and Eyes, which write the
// body's custom primitive data. Every machine builds the body and the eyes' logic; the look and the gaze only where
// cosmetics can run. Its look is mars::Mars_Steward_Config (Mars_Steward_Config.as).
//
// It devours: the Devour feature on its entity runs the clock (Script/ECS/Devour), a seized player's state machine gives
// up its controls and its view (Mars_PlayerCharacter_Hfsm_Devoured.as), and this script stages it. The victim's view is
// handed the View node, which is turned to the face (Seize) and hauled up to it (Lift); from Blink on a plate wearing the
// MarsStewardMaw look fills the victim's own view - black, then the eyes, the grin of needle teeth as the eyes catch
// fire, the maw gaping and coming down - and the eyes on the head turn evil for everyone else. When the victim is let go its view is its own again under the black plate, which then
// lifts: the world fades back in.
//
// It devours when the service fails: a mechanism sink on Mechanism.Channel.ServiceFailed, and each time the channel
// rises the steward seizes the nearest player it can. Nothing in the game asserts the channel yet but the sandbox's
// fail switch (Mars_SandboxSteward.as); the Mars_Devour cheat asks the kernel directly. It hands out no recipe yet.
// Placed from the Place Actors panel (Ck Entity Scripts); the spawner's transform is where its feet stand.

// The face its victim sees: generated by CkUsf from Shaders/Looks/StewardMaw.ush into Mars content (console:
// Ck_Usf_GenerateLooks MarsStewardMaw). The generator passes _Parameters to the shader positionally, so their order IS
// the .ush signature after In. The animated ones are custom primitive data, written by Push_MawFrame below (slots 0..3
// Strength, EyeOpen, Evil, Mouth; 4..7 Jaw, Zoom, Span, Veil; 8..10 the colour; 12..14 Heat, Shake, Tilt). Translucent,
// so the plate can lift off the view (Veil). Declared here, beside its only consumer: a top-level script asset is
// visible only in its own file.
asset MarsStewardMaw of UCkUsf_LookDefinition
{
    _UshIncludePath       = "/Project/Looks/StewardMaw.ush";
    _UshFunctionName      = n"Mars_Look_StewardMaw";
    _Domain               = ECk_Usf_Domain::SurfaceUnlit;
    _BlendMode            = ECk_Usf_BlendMode::Translucent;
    _LookName             = n"MarsStewardMaw";
    _GeneratedPackageRoot = "/Game/Mars/Materials/GeneratedLooks";

    // The eye plate's atlas: the eyes here are its cells.
    FCk_Usf_ParamDesc Atlas;
    Atlas._Name               = n"Atlas";
    Atlas._Type               = ECk_Usf_ParamType::Texture2D;
    Atlas._DefaultTexturePath = "/Game/Mars/Gameplay/PlayerCharacter/Eyes/Eyes_Atlas_Mars_T.Eyes_Atlas_Mars_T";
    _Parameters.Add(Atlas);

    FCk_Usf_ParamDesc Strength;
    Strength._Name                     = n"Strength";
    Strength._Type                     = ECk_Usf_ParamType::Scalar;
    Strength._DefaultScalar            = 0.0f;
    Strength._CustomPrimitiveData      = true;
    Strength._CustomPrimitiveDataIndex = 0;
    _Parameters.Add(Strength);

    FCk_Usf_ParamDesc EyeOpen;
    EyeOpen._Name                     = n"EyeOpen";
    EyeOpen._Type                     = ECk_Usf_ParamType::Scalar;
    EyeOpen._DefaultScalar            = 0.0f;
    EyeOpen._CustomPrimitiveData      = true;
    EyeOpen._CustomPrimitiveDataIndex = 1;
    _Parameters.Add(EyeOpen);

    FCk_Usf_ParamDesc Evil;
    Evil._Name                     = n"Evil";
    Evil._Type                     = ECk_Usf_ParamType::Scalar;
    Evil._DefaultScalar            = 0.0f;
    Evil._CustomPrimitiveData      = true;
    Evil._CustomPrimitiveDataIndex = 2;
    _Parameters.Add(Evil);

    FCk_Usf_ParamDesc Mouth;
    Mouth._Name                     = n"Mouth";
    Mouth._Type                     = ECk_Usf_ParamType::Scalar;
    Mouth._DefaultScalar            = 0.0f;
    Mouth._CustomPrimitiveData      = true;
    Mouth._CustomPrimitiveDataIndex = 3;
    _Parameters.Add(Mouth);

    FCk_Usf_ParamDesc Jaw;
    Jaw._Name                     = n"Jaw";
    Jaw._Type                     = ECk_Usf_ParamType::Scalar;
    Jaw._DefaultScalar            = 0.0f;
    Jaw._CustomPrimitiveData      = true;
    Jaw._CustomPrimitiveDataIndex = 4;
    _Parameters.Add(Jaw);

    FCk_Usf_ParamDesc Zoom;
    Zoom._Name                     = n"Zoom";
    Zoom._Type                     = ECk_Usf_ParamType::Scalar;
    Zoom._DefaultScalar            = 1.0f;
    Zoom._CustomPrimitiveData      = true;
    Zoom._CustomPrimitiveDataIndex = 5;
    _Parameters.Add(Zoom);

    FCk_Usf_ParamDesc Span;
    Span._Name                     = n"Span";
    Span._Type                     = ECk_Usf_ParamType::Scalar;
    Span._DefaultScalar            = 5.0f;
    Span._CustomPrimitiveData      = true;
    Span._CustomPrimitiveDataIndex = 6;
    _Parameters.Add(Span);

    FCk_Usf_ParamDesc Veil;
    Veil._Name                     = n"Veil";
    Veil._Type                     = ECk_Usf_ParamType::Scalar;
    Veil._DefaultScalar            = 0.0f;
    Veil._CustomPrimitiveData      = true;
    Veil._CustomPrimitiveDataIndex = 7;
    _Parameters.Add(Veil);

    // A Vector reads the whole float4 at 8..11; the look uses .rgb.
    FCk_Usf_ParamDesc Color;
    Color._Name                     = n"Color";
    Color._Type                     = ECk_Usf_ParamType::Vector;
    Color._DefaultVector            = FLinearColor(1.0, 0.9, 0.72, 1.0);
    Color._CustomPrimitiveData      = true;
    Color._CustomPrimitiveDataIndex = 8;
    _Parameters.Add(Color);

    FCk_Usf_ParamDesc Heat;
    Heat._Name                     = n"Heat";
    Heat._Type                     = ECk_Usf_ParamType::Scalar;
    Heat._DefaultScalar            = 0.0f;
    Heat._CustomPrimitiveData      = true;
    Heat._CustomPrimitiveDataIndex = 12;
    _Parameters.Add(Heat);

    FCk_Usf_ParamDesc Shake;
    Shake._Name                     = n"Shake";
    Shake._Type                     = ECk_Usf_ParamType::Scalar;
    Shake._DefaultScalar            = 0.0f;
    Shake._CustomPrimitiveData      = true;
    Shake._CustomPrimitiveDataIndex = 13;
    _Parameters.Add(Shake);

    FCk_Usf_ParamDesc Tilt;
    Tilt._Name                     = n"Tilt";
    Tilt._Type                     = ECk_Usf_ParamType::Scalar;
    Tilt._DefaultScalar            = 0.0f;
    Tilt._CustomPrimitiveData      = true;
    Tilt._CustomPrimitiveDataIndex = 14;
    _Parameters.Add(Tilt);

    FCk_Usf_ParamDesc AtlasCols;
    AtlasCols._Name          = n"AtlasCols";
    AtlasCols._Type          = ECk_Usf_ParamType::Scalar;
    AtlasCols._DefaultScalar = 8.0f;
    _Parameters.Add(AtlasCols);

    FCk_Usf_ParamDesc AtlasRows;
    AtlasRows._Name          = n"AtlasRows";
    AtlasRows._Type          = ECk_Usf_ParamType::Scalar;
    AtlasRows._DefaultScalar = 4.0f;
    _Parameters.Add(AtlasRows);

    // The resting eye (Classic Oval) and the one it turns into (Evil).
    FCk_Usf_ParamDesc RestCell;
    RestCell._Name          = n"RestCell";
    RestCell._Type          = ECk_Usf_ParamType::Scalar;
    RestCell._DefaultScalar = 1.0f;
    _Parameters.Add(RestCell);

    FCk_Usf_ParamDesc EvilCell;
    EvilCell._Name          = n"EvilCell";
    EvilCell._Type          = ECk_Usf_ParamType::Scalar;
    EvilCell._DefaultScalar = 24.0f;
