    // The layout, in half view widths (the view's left and right edges are -1 and +1, y runs down): an eye's atlas cell
    // is EyeSize wide, its centre EyeSpread out from the middle and EyeHeight down from it; the mouth is MouthWidth to
    // each corner, its bite line MouthHeight down.
    FCk_Usf_ParamDesc EyeSize;
    EyeSize._Name          = n"EyeSize";
    EyeSize._Type          = ECk_Usf_ParamType::Scalar;
    EyeSize._DefaultScalar = 0.5f;
    _Parameters.Add(EyeSize);

    FCk_Usf_ParamDesc EyeSpread;
    EyeSpread._Name          = n"EyeSpread";
