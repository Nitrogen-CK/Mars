// The pantry rat's two rat-local Masked looks (generated by CkUsf into Mars content):
//   MarsPantryRatSurface  - lit flat colour per slot (Body, Pink, Belly, Wood, Harness): Shaders/Looks/PantryRatSurface.ush
//   MarsPantryRatEyePlate - the shared eye plate (EyePlate.ush, unchanged) wrapped Masked: Shaders/Looks/PantryRatEyes.ush
// Regenerate in the editor with the console command `Ck_Usf_GenerateLooks MarsPantryRatSurface` /
// `Ck_Usf_GenerateLooks MarsPantryRatEyePlate`. The generator passes _Parameters positionally: their order IS the .ush
// signature after In.
//
// CUSTOM PRIMITIVE DATA 14 IS THE RAT FADE SLOT. FadeAlpha (1 = solid, 0 = gone; BusterBlock-style Masked cut,
// CkUsf_Hash21(floor(UV * 512)) < FadeAlpha) is read from CPD 14 by BOTH looks, so one write on the rat's skeletal mesh component
// fades body, spoon, harness and eyes together. CPD 0..13 are the eye plate's (constants_eyes::k_Slot_* layout, written
// only by the Eyes feature); nothing else on the rat primitive may use 14. An unwritten slot is not guaranteed to read
// the 1.0 default: seed CPD 14 = 1.0 before the rat's first visible frame (spec section 12). Food and props carried by
// the rat are separate primitives and never receive the rat's FadeAlpha.

asset MarsPantryRatSurface of UCkUsf_LookDefinition
{
    _UshIncludePath       = "/Project/Looks/PantryRatSurface.ush";
    _UshFunctionName      = n"Mars_Look_PantryRatSurface";
    _Domain               = ECk_Usf_Domain::SurfaceLit;
    _BlendMode            = ECk_Usf_BlendMode::Masked;
    _LookName             = n"MarsPantryRatSurface";
    _GeneratedPackageRoot = "/Game/Mars/Materials/GeneratedLooks";
    _UsedWithSkeletalMesh = true;

    FCk_Usf_ParamDesc Color;
    Color._Name          = n"Color";
    Color._Type          = ECk_Usf_ParamType::Vector;
    Color._DefaultVector = FLinearColor(0.1022, 0.0595, 0.0865, 1.0);
    _Parameters.Add(Color);

    FCk_Usf_ParamDesc FadeAlpha;
    FadeAlpha._Name                     = n"FadeAlpha";
    FadeAlpha._Type                     = ECk_Usf_ParamType::Scalar;
    FadeAlpha._DefaultScalar            = 1.0f;
    FadeAlpha._CustomPrimitiveData      = true;
    FadeAlpha._CustomPrimitiveDataIndex = 14;
    _Parameters.Add(FadeAlpha);
}

