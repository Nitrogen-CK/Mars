// Script asset globals are file-local: other files reach them through these accessors.
namespace utils_pantry_rat_look
{
    UCkUsf_LookDefinition Look_Surface() { return MarsPantryRatSurface; }

    // The rat's eye plate: the Lit look (Phase 7). The Unlit MarsPantryRatEyePlate stays defined (the R01 candidate wears it).
    UCkUsf_LookDefinition Look_EyePlate() { return MarsPantryRatEyePlateLit; }

    UCkUsf_LookDefinition Look_EyePlateUnlit() { return MarsPantryRatEyePlate; }

    // The custom-primitive-data slot both rat looks read FadeAlpha from.
    int32 Get_FadeAlphaCpdIndex() { return 14; }

    // Material slot name -> linear colour for the Surface look's Color (sRGB hex in the comments). EyePatch is not in
    // the table: it wears the eye-plate look.
    TMap<FName, FLinearColor> Make_SlotColors()
    {
        auto Colors = TMap<FName, FLinearColor>();
        Colors.Add(n"Body",    FLinearColor(0.1022, 0.0595, 0.0865, 1.0)); // #5A4553
        Colors.Add(n"Pink",    FLinearColor(0.6939, 0.1981, 0.2384, 1.0)); // #D97B86
        Colors.Add(n"Belly",   FLinearColor(0.8148, 0.6654, 0.5333, 1.0)); // #E9D5C1
        Colors.Add(n"Wood",    FLinearColor(0.3916, 0.1384, 0.0437, 1.0)); // #A8683B
        Colors.Add(n"Harness", FLinearColor(0.1559, 0.0561, 0.0203, 1.0)); // #6E4327
        return Colors;
    }
}
