    UFUNCTION()
    private void Step_Assert(FCk_Handle InHandle, FInstancedStruct InPayload)
    {
        Fill_Rows();
        Assert_Equals_Int(_Rows.Num(), 40, "40 golden rows");
        for (const FMars_DripGoldenRow& Row : _Rows)
        {
            auto Schedule = FMars_DripSchedule();
            Schedule.Length = Row.Length;
            Schedule.Rate = Row.Rate;
            Schedule.Seed = Row.Seed;
            Schedule.Jitter = Row.Jitter;
            Schedule.Mode = Row.Mode;
            Schedule.Setup();
            const FString Label = f"L {Row.Length} rate {Row.Rate} seed {Row.Seed} k {Row.K}";
            Assert_Equals_Float(Schedule.Period, Row.Period, 1e-6, f"period ({Label})");
            Assert_Equals_Float(Schedule.FallSeconds, Row.FallSeconds, 1e-5, f"fall seconds ({Label})");
            Assert_Equals_Float(Schedule.Get_Release(Row.K), Row.Release, 1e-4, f"release ({Label})");
            Assert_Equals_Float(Schedule.Get_Impact(Row.K), Row.Impact, 1e-4, f"impact ({Label})");
            Assert_True(Schedule.Is_Skipped(Row.K) == Row.Skipped, f"skip flag ({Label})");
        }
    }
