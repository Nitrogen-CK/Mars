// The AngelScript drip clock matches the plain-Python reference (Tools/Blender/mars_water/drip_reference.py, uint32
// hash maths masked) on 40 golden rows: 8 strands (pipe drip, thread, three-storey fall, atrium, stream, Air, slow seep,
// a seed next to 1) x drops -1, 0, 3, 17, 250. Release and impact times agree within 1e-4 s, the skip flags exactly, so
// the hash, the seed key and the slot cap are the same in both. Regenerate the rows with --golden after a clock change.
struct FMars_DripGoldenRow
{
    float Length = 0.0;
    float Rate = 0.0;
    float Seed = 0.0;
    float Jitter = 0.0;
    float Mode = 0.0;
    int32 K = 0;
    float Release = 0.0;
    float Impact = 0.0;
    bool Skipped = false;
    float Period = 0.0;
    float FallSeconds = 0.0;

    FMars_DripGoldenRow(float InLength, float InRate, float InSeed, float InJitter, float InMode, int32 InK, float InRelease,
        float InImpact, bool InSkipped, float InPeriod, float InFallSeconds)
    {
        Length = InLength;
        Rate = InRate;
        Seed = InSeed;
        Jitter = InJitter;
        Mode = InMode;
        K = InK;
        Release = InRelease;
        Impact = InImpact;
        Skipped = InSkipped;
        Period = InPeriod;
        FallSeconds = InFallSeconds;
    }
}

