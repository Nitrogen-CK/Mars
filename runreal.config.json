{
  "project": {
    "name": "Mars"
  },
	"engine": {
		"gitSource": "https://github.com/CommitAndChill/UnrealEngine-Angelscript",
		"gitBranch": "main-ck"
	},
  "workflows": [
    {
      "name": "Build Editor",
      "id": "build-editor",
      "steps": [
        { "command": "runreal engine install" },
        { "command": "runreal engine update", "args": ["--setup"] },
        { "command": "runreal build editor" }
      ]
    },
    {
      "name": "Build Game",
      "id": "build-game",
      "steps": [
        { "command": "runreal engine install" },
        { "command": "runreal engine update", "args": ["--setup"] },
        { "command": "runreal build game" }
      ]
    }
  ]
}
