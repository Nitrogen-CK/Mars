						"index": 5,
						"name": "Boost",
						"node": 11,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float g = pow(saturate(Glow), Falloff);\nreturn Color * g * Intensity * Flicker.x * max(1.0 + Boost, 0.0);",
					"Description": "Wax Glow"
				}
