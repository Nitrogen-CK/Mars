						"node": 19,
						"output": 1
					},
					{
						"index": 8,
						"name": "UseDebug",
						"node": 13,
						"output": 0
					},
					{
						"index": 9,
						"name": "Mask",
						"node": 11,
						"output": 0
					},
					{
						"index": 10,
						"name": "Sharp",
						"node": 1,
						"output": 0
					},
					{
						"index": 11,
						"name": "Breakup",
						"node": 2,
						"output": 0
					},
					{
						"index": 12,
						"name": "EdgeBoost",
						"node": 3,
						"output": 0
					},
					{
						"index": 13,
						"name": "BandDepth",
						"node": 4,
						"output": 0
					},
					{
						"index": 14,
						"name": "BandSoft",
						"node": 5,
						"output": 0
					},
					{
						"index": 15,
						"name": "BandWobble",
						"node": 6,
						"output": 0
					},
					{
						"index": 16,
						"name": "BandRamp",
						"node": 7,
						"output": 0
					},
					{
						"index": 17,
						"name": "SearRange",
						"node": 0,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float4 sa = lerp(SearA, DbgA, UseDebug);\nfloat4 sb = lerp(SearB, DbgB, UseDebug);\nfloat3 he = max((BMax - BMin) * 0.5, 1e-3);\nfloat3 q = (P - (BMax + BMin) * 0.5) / he;\nfloat3 n = normalize(N);\n\n// how much each seared axis faces this pixel (per-face on a cube, a smooth blend on round shapes)\nfloat3 wp = pow(saturate(n), Sharp);\nfloat3 wn = pow(saturate(-n), Sharp);\nfloat wsum = wp.x + wp.y + wp.z + wn.x + wn.y + wn.z + 1e-5;\nfloat face = (wp.x * sa.x + wn.x * sa.y + wp.y * sa.z + wn.y * sa.w + wp.z * sb.x + wn.z * sb.y) / wsum;\n\n// the cooked band creeping in from every seared face (distance to that face, cm)\nfloat wobble = (Mask.b - 0.5) * BandWobble;\nfloat3 dpos = (1.0 - q) * he + wobble;\nfloat3 dneg = (1.0 + q) * he + wobble;\nfloat s6[6] = { sa.x, sa.y, sa.z, sa.w, sb.x, sb.y };\nfloat d6[6] = { dpos.x, dneg.x, dpos.y, dneg.y, dpos.z, dneg.z };\nfloat reach = BandDepth * sb.z;\nfloat band = 0.0;\nfor (int i = 0; i < 6; i++)\n{\n    float depth = max(saturate(s6[i]) * reach, 1e-3);\n    band = max(band, (1.0 - smoothstep(depth * (1.0 - BandSoft), depth, d6[i])) * saturate(s6[i] * 6.0));\n}\nband *= saturate(reach * 20.0);\n\n// the crust comes up in patches and a little faster on the edges\nfloat sear = face * (1.0 + Mask.a * EdgeBoost);\nsear = max(0.0, sear + (Mask.b - 0.5) * Breakup * saturate(sear * 3.0));\nfloat u = max(sear / max(SearRange, 1e-3), band * BandRamp);\nreturn float4(saturate(u), smoothstep(0.2, 0.9, sear), saturate((sear - 1.25) / 0.6), sb.w);",
					"OutputType": "CMOT_Float4",
					"Description": "MeatCook (mars_cooking_hlsl): sear -> time, crust, burn, oil"
				}
			},
