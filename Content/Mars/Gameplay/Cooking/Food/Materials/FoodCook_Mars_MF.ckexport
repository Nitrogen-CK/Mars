				"id": 20,
				"class": "Custom",
				"name": "MaterialExpressionCustom_1",
				"inputs": [
					{
						"index": 0,
						"name": "P",
						"node": 15,
						"output": 0
					},
					{
						"index": 1,
						"name": "N",
						"node": 17,
						"output": 0
					},
					{
						"index": 2,
						"name": "BMin",
						"node": 18,
						"output": 2,
						"mask": "rgb"
					},
					{
						"index": 3,
						"name": "BMax",
						"node": 18,
						"output": 3,
						"mask": "rgb"
					},
					{
						"index": 4,
						"name": "SearA",
						"node": 19,
						"output": 0
					},
					{
						"index": 5,
						"name": "SearB",
						"node": 19,
						"output": 1
					},
					{
