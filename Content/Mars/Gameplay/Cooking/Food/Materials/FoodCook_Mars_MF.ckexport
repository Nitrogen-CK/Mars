					{
						"index": 4,
						"name": "UseDebug",
						"node": 13,
						"output": 0
					},
					{
						"index": 5,
						"name": "Mask",
						"node": 11,
						"output": 0
					},
					{
						"index": 6,
						"name": "Cavity",
						"node": 12,
						"output": 0
					},
					{
						"index": 7,
						"name": "Lag",
						"node": 8,
						"output": 0
					}
				],
				"outputs": [
					"return",
					"SearZ"
				],
				"props":
				{
					"Code": "float4 sa = lerp(SearA, DbgA, UseDebug);\nfloat4 sb = lerp(SearB, DbgB, UseDebug);\nfloat cf = saturate(Mask.r * Cavity);\nfloat k = lerp(1.0 - saturate(Lag), 1.0, cf);\nSearZ = float4(sb.xy * k, sb.z, sb.w);\nreturn sa * k;",
					"OutputType": "CMOT_Float4",
					"Description": "FoodCookFirst: crevices sear later"
				}
			},
