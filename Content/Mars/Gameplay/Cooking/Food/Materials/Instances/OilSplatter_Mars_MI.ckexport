				"outputs": [
					"return",
					"Opa"
				],
				"props":
				{
					"Code": "float2 p = (UV - 0.5) * 2.0;\nfloat r = length(p);\nfloat a = atan2(p.y, p.x);\nfloat edge = 0.82 + Wobble * (0.08 * sin(a * 5.0 + Seed * 6.2831853) + 0.05 * sin(a * 9.0 + Seed * 3.1));\nfloat body = 1.0 - smoothstep(edge - Softness, edge, r);\nfloat rim = smoothstep(edge - 0.4, edge - 0.05, r);\nOpa = body * saturate(PCA);\nreturn PC * (1.0 - RimDarken * rim);",
					"Description": "Droplet spot"
				}
			},
