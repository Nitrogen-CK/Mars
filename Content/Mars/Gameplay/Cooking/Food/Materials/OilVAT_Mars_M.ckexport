				],
				"props":
				{
					"Code": "float frames = max(round(Frames), 1.0);\nfloat phase = frac(T * Speed / max(Seconds, 1e-3));\nfloat v = (floor(phase * frames) + 0.5) / frames;\nv = lerp(v, 1.0 - v, saturate(FlipV));\nreturn float2(Column.x, v);",
					"OutputType": "CMOT_Float2",
					"Description": "OilVatUV: column + frame row"
				}
			},
