				],
				"props":
				{
					"Code": "float patchy = lerp(1.0, saturate(Breakup.x * 1.6), saturate(CoatBreakup));\nfloat coat = saturate(Oil.x) * patchy;\nRoughOut = saturate(lerp(RoughIn.x, RoughIn.x * BaseGloss, coat));\nreturn saturate(coat * Strength);",
					"OutputType": "CMOT_Float1",
					"Description": "OilCoat: oil -> clear coat, gloss under it"
				}
