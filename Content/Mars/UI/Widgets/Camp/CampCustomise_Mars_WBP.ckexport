		{
			"name": "_KeepSlateAliveWhenPooled",
			"type": "bool",
			"category": "Ck|UI|Lifecycle",
			"value": false,
			"tooltip": "Opt-in for UCk_WidgetStack_UE's Slate keep-alive: the widget pool retains this UObject on\nclose but drops its Slate tree (bReleaseSlate=true), so every reopen pays a full\nRebuildWidget of the authored tree. With this set, the stack pins the tree across the\nrelease and a reopen (or a PreWarmWidgetClass) reuses it — no rebuild.\n\nCONTRACT CHANGE the widget must be written for: with the tree surviving, Construct/Destruct\nfire once per Slate build (SObjectWidget lifetime), NOT once per open/close. Per-open logic\nbelongs on OnActivated/OnDeactivated; per-close cleanup must be driven explicitly."
		},
		{
			"name": "bIsBackHandler",
			"type": "bool",
			"category": "Back",
			"value": true,
			"tooltip": "True to receive \"Back\" actions automatically. Custom back handler behavior can be provided, default is to deactivate."
		},
		{
			"name": "bIsBackActionDisplayedInActionBar",
			"type": "bool",
			"category": "Back",
			"value": true,
			"tooltip": "True to receive \"Back\" actions automatically. Custom back handler behavior can be provided, default is to deactivate."
		},
		{
			"name": "OverrideBackActionDisplayName",
			"type": "FText",
			"category": "Back",
			"value": "",
			"tooltip": "You can specify an override for display name for the back action. If left empty, the default will be used."
		},
		{
