				],
				"props":
				{
					"Code": "\nfloat V = max(C.r, max(C.g, C.b));\nfloat Other = max(C.g, C.b);\nfloat Chroma = saturate((C.r - Other) / max(V, 0.0001));\nfloat T = saturate((Chroma - MaskLow) / max(MaskHigh - MaskLow, 0.0001));\nfloat ClothMask = T * T * (3.0 - 2.0 * T);\nfloat3 Col = V * lerp(NeutralTint, PlayerTint, ClothMask * TintAmount) * Brightness;\nreturn float4(Col, C.a * StateOpacity);\n",
					"OutputType": "CMOT_Float4",
					"Description": "EmoteIconTint"
				}
			},
