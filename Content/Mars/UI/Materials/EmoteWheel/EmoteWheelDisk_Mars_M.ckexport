				],
				"props":
				{
					"Code": "\nfloat2 P = UV - 0.5;\nfloat r = length(P) * 2.0;\nfloat aa = max(fwidth(r), 1e-4);\nfloat disk = 1.0 - smoothstep(1.0 - aa, 1.0, r);\nfloat N = max(round(SectorCount), 1.0);\nconst float TwoPi = 6.28318530718;\nfloat w = TwoPi / N;\nfloat a = atan2(P.x, -P.y);\na = a < 0.0 ? a + TwoPi : a;\nfloat idx = floor(a / w + 0.5);\nidx = idx >= N ? idx - N : idx;\nfloat rel = a - idx * w;\nrel = rel > 3.14159265 ? rel - TwoPi : rel;\nfloat arc = (w * 0.5 - abs(rel)) * r;\nfloat arcAA = max(fwidth(arc), 1e-4);\nfloat divider = 1.0 - smoothstep(DividerWidth - arcAA, DividerWidth + arcAA, arc);\ndivider *= smoothstep(DeadZone - aa, DeadZone + aa, r);\nfloat hovered = (HoveredIndex >= 0.0 && abs(idx - HoveredIndex) < 0.5) ? 1.0 : 0.0;\nfloat3 col = Paper * lerp(NormalColor, HoveredColor, hovered);\ncol = lerp(col, DividerColor, divider);\nreturn float4(col, disk);\n",
					"OutputType": "CMOT_Float4",
					"Description": "EmoteWheelDisk"
				}
			},
