					"Description": "Streak In"
				}
			},
			{
				"id": 20,
				"class": "Custom",
				"name": "MaterialExpressionCustom_16",
				"inputs": [
					{
						"index": 0,
						"name": "WP",
						"node": 14,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 1,
						"name": "Axis",
						"node": 15,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float3 N = normalize(cross(ddx(WP), ddy(WP)));\nreturn smoothstep(0.6, 0.85, abs(dot(N, normalize(Axis))));",
					"OutputType": "CMOT_Float1",
					"Description": "Face Mask"
				}
			},
			{
				"id": 21,
				"class": "Custom",
				"name": "MaterialExpressionCustom_17",
				"inputs": [
					{
						"index": 0,
						"name": "UV",
						"node": 12,
						"output": 0
					},
					{
						"index": 1,
						"name": "Flip",
						"node": 8,
						"output": 0
					},
					{
						"index": 2,
						"name": "DC",
						"node": 13,
						"output": 5,
						"mask": "rgba"
					},
					{
						"index": 3,
						"name": "Along",
						"node": 17,
						"output": 0
					},
					{
						"index": 4,
						"name": "T",
						"node": 11,
						"output": 0
					},
					{
						"index": 5,
						"name": "P",
						"node": 19,
						"output": 0
					},
					{
						"index": 6,
						"name": "Face",
						"node": 20,
						"output": 0
					}
				],
				"outputs": [
					"return",
					"Rivulet",
					"Mineral"
				],
				"props":
				{
					"Code": "float2 U = float2(UV.x, lerp(UV.y, 1.0 - UV.y, Flip));\nfloat4 Dc = DC; float Len = 2.0 * length(Along); float Tt = T; float4 Pp = P; float Fm = Face;\nfloat Rv = 0; float Mn = 0;\nfloat Op = MarsWet_Streak(U, Dc, Len, Tt, Pp, Fm, Rv, Mn);\nRivulet = Rv; Mineral = Mn; return Op;",
					"OutputType": "CMOT_Float1",
					"Description": "Streak",
					"IncludeFilePaths": [
						"/Project/Water/MarsWet.ush"
					]
				}
			},
			{
				"id": 22,
				"class": "Custom",
				"name": "MaterialExpressionCustom_18",
				"inputs": [
					{
						"index": 0,
						"name": "Damp",
						"node": 7,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 1,
						"name": "MineralTint",
						"node": 6,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 2,
						"name": "Mineral",
						"node": 21,
						"output": 2
					}
				],
				"props":
				{
					"Code": "return lerp(Damp.rgb, MineralTint.rgb, saturate(Mineral));",
					"Description": "Streak Colour"
				}
			},
			{
				"id": 23,
				"class": "Custom",
				"name": "MaterialExpressionCustom_19",
				"inputs": [
					{
						"index": 0,
						"name": "HaloR",
						"node": 5,
						"output": 0
					},
					{
						"index": 1,
						"name": "CoreR",
						"node": 4,
						"output": 0
