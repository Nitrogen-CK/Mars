					{
						"index": 2,
						"name": "Rivulet",
						"node": 21,
						"output": 1
					}
				],
				"props":
				{
					"Code": "return lerp(HaloR, CoreR, saturate(Rivulet));",
					"OutputType": "CMOT_Float1",
					"Description": "Streak Roughness"
				}
			},
			{
				"id": 24,
				"class": "Custom",
				"name": "MaterialExpressionCustom_20",
				"inputs": [
					{
						"index": 0,
						"name": "Rivulet",
						"node": 21,
						"output": 1
					}
				],
				"props":
				{
					"Code": "return normalize(float3(0.0, 0.0, 1.0) + float3(0.0, 0.25 * Rivulet, 0.0));",
					"Description": "Streak Normal"
				}
			},
