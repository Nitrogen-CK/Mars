					{
						"index": 7,
						"name": "Dir",
						"node": 11,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 8,
						"name": "Strength",
						"node": 31,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float f = saturate(Flex);\nfloat ph = Id * 6.2831 + dot(WP, float3(0.0071, 0.0053, 0.0029)) + Rand * 4.1;\nfloat t = Time * Speed;\nfloat sway = sin(t + ph) * 0.65 + sin(t * 2.31 + ph * 1.7) * 0.35;\nfloat flutter = sin(t * 7.9 + ph * 3.3) * Flutter;\nfloat3 d = normalize(float3(Dir.x, Dir.y, 0.0) + 1e-4);\nreturn (d * sway + float3(-d.y, d.x, 0.0) * flutter + float3(0.0, 0.0, -abs(sway) * 0.25)) * Strength * f * f;",
					"Description": "Wind"
				}
			},
