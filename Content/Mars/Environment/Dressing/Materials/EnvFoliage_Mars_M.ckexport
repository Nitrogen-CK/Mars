						"index": 8,
						"name": "ValueVar",
						"node": 6,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float h = frac(sin(dot(floor(ObjPos * 0.01), float3(12.9898, 78.233, 37.719))) * 43758.5453);\nfloat r = frac(h + Rand * 7.137 + Extra * 3.31);\nfloat v = r * 2.0 - 1.0;\nfloat hv = frac(r * 13.17 + 0.37) * 2.0 - 1.0;\nfloat3 c = Col * Tint.rgb;\nc *= lerp(1.0, Alpha, Cavity);\nc *= 1.0 + v * ValueVar;\nc *= float3(1.0 + hv * HueVar, 1.0 + hv * HueVar * 0.25, 1.0 - hv * HueVar);\nreturn max(c, 0.0);",
					"Description": "Leaf Colour + Variation"
				}
			},
			{
				"id": 30,
				"class": "Custom",
				"name": "MaterialExpressionCustom_4",
				"inputs": [
					{
						"index": 0,
						"name": "Base",
						"node": 29,
						"output": 0
					},
					{
						"index": 1,
						"name": "Dry",
						"node": 13,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 2,
						"name": "D1",
						"node": 17,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float l = dot(Base, float3(0.2126, 0.7152, 0.0722));\nreturn lerp(Base, Dry.rgb * (l / 0.06), saturate(D1));",
					"Description": "Dryness"
				}
			},
			{
				"id": 31,
				"class": "Custom",
				"name": "MaterialExpressionCustom_5",
				"inputs": [
					{
						"index": 0,
						"name": "Strength",
						"node": 8,
						"output": 0
					},
					{
						"index": 1,
						"name": "D2",
						"node": 19,
						"output": 0
					},
					{
						"index": 2,
						"name": "D3",
						"node": 21,
						"output": 0
					},
					{
						"index": 3,
						"name": "Sway",
						"node": 12,
						"output": 0
					}
				],
				"props":
				{
					"Code": "return Strength * max(1.0 + D2, 0.0) * lerp(1.0, max(1.0 + D3, 0.0), Sway);",
					"OutputType": "CMOT_Float1",
					"Description": "Wind x Env Data"
				}
