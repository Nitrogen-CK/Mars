				"id": 34,
				"class": "Custom",
				"name": "MaterialExpressionCustom_6",
				"inputs": [
					{
						"index": 0,
						"name": "Flex",
						"node": 27,
						"output": 0
					},
					{
						"index": 1,
						"name": "Id",
						"node": 28,
						"output": 0
