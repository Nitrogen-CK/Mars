				"outputs": [
					"return",
					"Rough"
				],
				"props":
				{
					"Code": "float3 q_ng = WP * 0.01 / max(GrimeScale, 0.05);\nfloat ng = 0.0, amp_ng = 0.5;\n[unroll] for (int oct_ng = 0; oct_ng < 3; oct_ng++)\n{\n    float3 i_ng = floor(q_ng);\n    float3 f_ng = frac(q_ng);\n    f_ng = f_ng * f_ng * (3.0 - 2.0 * f_ng);\n    float s_ng = 0.0;\n    [unroll] for (int c_ng = 0; c_ng < 8; c_ng++)\n    {\n        float3 k_ng = float3(c_ng & 1, (c_ng >> 1) & 1, (c_ng >> 2) & 1);\n        float h_ng = frac(sin(dot(i_ng + k_ng, float3(127.1, 311.7, 74.7))) * 43758.5453);\n        float3 w_ng = lerp(1.0 - f_ng, f_ng, k_ng);\n        s_ng += h_ng * w_ng.x * w_ng.y * w_ng.z;\n    }\n    ng += s_ng * amp_ng;\n    amp_ng *= 0.5;\n    q_ng = q_ng * 2.03 + 17.1;\n}\nng /= 0.875;\nfloat3 q_nm = WP * 0.01 / max(MossScale, 0.05) + 31.7;\nfloat nm = 0.0, amp_nm = 0.5;\n[unroll] for (int oct_nm = 0; oct_nm < 3; oct_nm++)\n{\n    float3 i_nm = floor(q_nm);\n    float3 f_nm = frac(q_nm);\n    f_nm = f_nm * f_nm * (3.0 - 2.0 * f_nm);\n    float s_nm = 0.0;\n    [unroll] for (int c_nm = 0; c_nm < 8; c_nm++)\n    {\n        float3 k_nm = float3(c_nm & 1, (c_nm >> 1) & 1, (c_nm >> 2) & 1);\n        float h_nm = frac(sin(dot(i_nm + k_nm, float3(127.1, 311.7, 74.7))) * 43758.5453);\n        float3 w_nm = lerp(1.0 - f_nm, f_nm, k_nm);\n        s_nm += h_nm * w_nm.x * w_nm.y * w_nm.z;\n    }\n    nm += s_nm * amp_nm;\n    amp_nm *= 0.5;\n    q_nm = q_nm * 2.03 + 17.1;\n}\nnm /= 0.875;\nfloat grime = saturate((ng - (1.0 - GrimeAmount)) * 3.0);\nfloat3 c = lerp(Base, Base * GrimeColor.rgb, grime);\nfloat up = saturate((N.z - (1.0 - MossFacing)) / max(MossFacing, 0.05));\nfloat moss = saturate((up * nm - (1.0 - MossAmount)) * 4.0) * step(0.001, MossAmount);\nc = lerp(c, MossColor.rgb * (0.75 + 0.5 * nm), moss);\nfloat wet = saturate(Wetness);\nc *= lerp(1.0, 0.5, wet);\nRough = lerp(lerp(Roughness, 0.95, moss), 0.1, wet * (1.0 - moss * 0.6));\nreturn c;",
					"Description": "Grime / Moss / Wet"
				}
