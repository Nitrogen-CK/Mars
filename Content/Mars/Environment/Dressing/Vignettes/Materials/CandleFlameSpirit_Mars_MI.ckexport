						"index": 3,
						"name": "Offset",
						"node": 9,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float p = Id * 7.31 + Rand * 3.17 + dot(ObjPos, float3(0.0123, 0.0217, 0.0079)) + Offset;\nreturn frac(p);",
					"OutputType": "CMOT_Float1",
					"Description": "Flame Phase"
				}
			},
			{
				"id": 18,
				"class": "Custom",
				"name": "MaterialExpressionCustom_13",
				"inputs": [
					{
						"index": 0,
						"name": "Time",
						"node": 16,
						"output": 0
					},
					{
						"index": 1,
						"name": "Speed",
						"node": 6,
						"output": 0
					},
					{
						"index": 2,
						"name": "Phase",
						"node": 17,
						"output": 0
					},
					{
						"index": 3,
						"name": "Amount",
						"node": 7,
						"output": 0
					},
					{
						"index": 4,
						"name": "Gutter",
						"node": 8,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float t = Time * Speed + Phase * 61.0;\nfloat n = sin(t * 6.1) * 0.5 + sin(t * 13.7 + 1.3) * 0.3 + sin(t * 23.3 + 2.1) * 0.2;\nfloat gutter = saturate(sin(t * 0.37 + Phase * 17.0) * 4.0 - 3.2);\nfloat i = 1.0 + n * Amount - gutter * Gutter;\nfloat sx = sin(t * 2.3) * 0.6 + sin(t * 5.9 + 0.7) * 0.4;\nfloat sy = sin(t * 1.9 + 1.1) * 0.6 + sin(t * 4.7 + 2.3) * 0.4;\nreturn float3(max(i, 0.05), sx, sy);",
					"Description": "Flicker"
				}
			},
			{
				"id": 19,
				"class": "Custom",
				"name": "MaterialExpressionCustom_14",
				"inputs": [
					{
						"index": 0,
						"name": "Height",
						"node": 13,
						"output": 0
					},
					{
						"index": 1,
						"name": "Core",
						"node": 1,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 2,
						"name": "Tip",
						"node": 2,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 3,
						"name": "Base",
						"node": 3,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 4,
						"name": "Intensity",
						"node": 0,
						"output": 0
					},
					{
						"index": 5,
						"name": "Flicker",
						"node": 18,
						"output": 0
					},
					{
						"index": 6,
						"name": "Boost",
						"node": 10,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float h = saturate(Height);\nfloat3 c = lerp(Core, Tip, smoothstep(0.35, 1.0, h));\nc = lerp(Base, c, smoothstep(0.0, 0.22, h));\nreturn c * Intensity * Flicker.x * max(1.0 + Boost, 0.0);",
					"Description": "Flame Colour"
				}
			},
			{
				"id": 20,
				"class": "Custom",
				"name": "MaterialExpressionCustom_15",
				"inputs": [
					{
						"index": 0,
						"name": "Height",
						"node": 13,
						"output": 0
					},
					{
						"index": 1,
						"name": "Flicker",
						"node": 18,
						"output": 0
					},
					{
						"index": 2,
						"name": "Sway",
						"node": 4,
						"output": 0
					},
					{
						"index": 3,
						"name": "Stretch",
						"node": 5,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float h = saturate(Height);\nfloat bend = h * h * Sway;\nreturn float3(Flicker.y * bend, Flicker.z * bend, h * (Flicker.x - 1.0) * Stretch);",
					"Description": "Flame Offset"
				}
			},
