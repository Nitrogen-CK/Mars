				],
				"outputs": [
					"return",
					"Mask"
				],
				"props":
				{
					"Code": "float3 n = normalize(N);\nfloat3 w = pow(abs(n), 4.0);\nw /= (w.x + w.y + w.z);\nfloat ang0 = radians(Angle);\nfloat c0 = cos(ang0), s0 = sin(ang0);\nfloat3 bump = 0.0;\nfloat mask = 0.0;\n[unroll]\nfor (int i = 0; i < 3; i++)\n{\n    float wi = w[i];\n    [branch]\n    if (wi < 0.02) continue;\n    float sg;\n    float2 uv;\n    float3 ua, va;\n    if (i == 0) { sg = n.x < 0.0 ? -1.0 : 1.0; uv = float2(P.y * sg, -P.z); ua = float3(0.0, sg, 0.0); va = float3(0.0, 0.0, -1.0); }\n    else if (i == 1) { sg = n.y < 0.0 ? -1.0 : 1.0; uv = float2(-P.x * sg, -P.z); ua = float3(-sg, 0.0, 0.0); va = float3(0.0, 0.0, -1.0); }\n    else { uv = P.xy; ua = float3(1.0, 0.0, 0.0); va = float3(0.0, 1.0, 0.0); }\n    uv /= (Tile * 100.0);\n    uv = float2(uv.x * c0 - uv.y * s0, uv.x * s0 + uv.y * c0);\n    float2 nxy = 0.0;\n    float m = 0.0;\n    float wsum = 0.0;\n    [unroll]\n    for (int k = 0; k < 2; k++)\n    {\n        float2 q = uv + k * 0.5;\n        float2 cell = floor(q) + k * 17.0;\n        float2 f = frac(q) - 0.5;\n        float tw = (1.0 - 2.0 * abs(f.x)) * (1.0 - 2.0 * abs(f.y)) + 0.001;\n        float2 h = frac(sin(float2(dot(cell, float2(127.1, 311.7)), dot(cell, float2(269.5, 183.3)))) * 43758.5453);\n        float a = h.x * 6.2831853 * Bomb;\n        float2 off = h * 7.31 * Bomb;\n        float ca = cos(a), sa = sin(a);\n        float2 ruv = float2(uv.x * ca - uv.y * sa, uv.x * sa + uv.y * ca) + off;\n        m += Texture2DSample(MaskTex, MaskTexSampler, ruv).r * tw;\n        float3 tn = UnpackNormalMap(Texture2DSample(NrmTex, NrmTexSampler, ruv * (Tile / NrmTile))).xyz;\n        float tot = a + ang0;\n        float ct = cos(tot), st = sin(tot);\n        nxy += float2(tn.x * ct + tn.y * st, -tn.x * st + tn.y * ct) * tw;\n        wsum += tw;\n    }\n    mask += m / wsum * wi;\n    bump += (nxy.x * ua + nxy.y * va) / wsum * wi;\n}\nMask = mask;\nreturn normalize(n + bump);",
					"Description": "PaintTriplanarBomb (Mise)"
				}
			},
			{
				"id": 26,
				"class": "Custom",
