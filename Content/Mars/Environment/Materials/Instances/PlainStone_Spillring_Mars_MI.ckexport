				],
				"outputs": [
					"return",
					"Roughness"
				],
				"props":
				{
					"Code": "float3 wash = Ramp;\nfloat3 lo = 2.0 * Base * wash;\nfloat3 hi = 1.0 - 2.0 * (1.0 - Base) * (1.0 - wash);\nfloat3 over = lerp(hi, lo, step(Base, 0.5));\nRoughness = saturate(RoughIn + (M - 0.5) * RoughBias * 2.0);\nreturn lerp(Base, over, Strength);",
					"Description": "PaintWash (Mise)"
				}
			},
