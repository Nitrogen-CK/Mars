			{
				"id": 39,
				"class": "Custom",
				"name": "MaterialExpressionCustom_4",
				"inputs": [
					{
						"index": 0,
						"name": "Base",
						"node": 20,
						"output": 0
					},
					{
						"index": 1,
						"name": "Mask",
						"node": 28,
						"output": 1,
						"mask": "r"
					},
					{
						"index": 2,
						"name": "Shadow",
						"node": 31,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 3,
						"name": "Mid",
						"node": 32,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 4,
						"name": "High",
						"node": 33,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 5,
						"name": "Contrast",
						"node": 34,
						"output": 0
					},
					{
						"index": 6,
						"name": "Strength",
						"node": 35,
						"output": 0
					},
					{
						"index": 7,
						"name": "Diffuse",
						"node": 29,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 8,
						"name": "DiffuseWeight",
						"node": 36,
						"output": 0
					},
					{
						"index": 9,
						"name": "RoughIn",
						"node": 13,
						"output": 2,
						"mask": "g"
					},
					{
						"index": 10,
						"name": "RoughBias",
						"node": 37,
						"output": 0
					}
				],
				"outputs": [
					"return",
					"Roughness"
				],
				"props":
				{
					"Code": "float m = saturate((Mask - 0.5) * Contrast + 0.5);\nfloat3 wash = m < 0.5 ? lerp(Shadow, Mid, m * 2.0) : lerp(Mid, High, m * 2.0 - 1.0);\nwash = lerp(wash, Diffuse, DiffuseWeight);\nfloat3 lo = 2.0 * Base * wash;\nfloat3 hi = 1.0 - 2.0 * (1.0 - Base) * (1.0 - wash);\nfloat3 over = lerp(hi, lo, step(Base, 0.5));\nRoughness = saturate(RoughIn + (m - 0.5) * RoughBias * 2.0);\nreturn lerp(Base, over, Strength);",
					"Description": "PaintWash (Mise)"
				}
			},
			{
				"id": 40,
				"class": "Custom",
				"name": "MaterialExpressionCustom_5",
				"inputs": [
					{
						"index": 0,
						"name": "Base",
						"node": 14,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 1,
						"name": "Detail",
						"node": 30,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 2,
						"name": "Strength",
						"node": 38,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float3 d = normalize(lerp(float3(0.0, 0.0, 1.0), Detail, Strength));\nfloat3 t = Base + float3(0.0, 0.0, 1.0);\nfloat3 u = d * float3(-1.0, -1.0, 1.0);\nreturn normalize(t * dot(t, u) - u * t.z);",
					"Description": "PaintNormal (Mise)"
				}
			}
		],
