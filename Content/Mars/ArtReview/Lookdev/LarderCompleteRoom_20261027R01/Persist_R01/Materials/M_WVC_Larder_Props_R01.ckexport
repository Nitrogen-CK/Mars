				"props":
				{
					"Code": "float3 W=pow(abs(normalize(N)),8); W/=max(dot(W,float3(1,1,1)),.0001); N=normalize(N);\nfloat3 S=float3(N.x>=0?1:-1,N.y>=0?1:-1,N.z>=0?1:-1);\nfloat2 A=X.xy/max(X.z,.1), B=Y.xy/max(Y.z,.1), C=Z.xy/max(Z.z,.1);\nfloat3 D=float3(0,A.x,A.y*S.x)*W.x+float3(B.x,0,-B.y*S.y)*W.y+float3(C.x,C.y*S.z,0)*W.z;\nreturn normalize(N+(D-N*dot(N,D))*Strength);",
					"Description": "Decoded independent normal slopes in signed world tangent bases; original geometry normal retained"
				}
