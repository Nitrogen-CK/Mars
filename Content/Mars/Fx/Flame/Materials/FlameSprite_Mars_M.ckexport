					{
						"index": 7,
						"name": "Core",
						"node": 2,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 8,
						"name": "Tip",
						"node": 3,
						"output": 0,
						"mask": "rgb"
					}
				],
				"props":
				{
					"Code": "float2 q = float2(UV.x - 0.5, 0.5 - UV.y) * 2.0;\nfloat phase = Dyn.x;\nfloat age = Dyn.y;\nfloat t = Time * 1.0 + phase * 61.0;\nfloat flick = 1.0 + Flicker * (sin(t * 6.1) * 0.5 + sin(t * 13.7 + 1.3) * 0.3 + sin(t * 23.3 + 2.1) * 0.2);\nfloat h = saturate((q.y + 0.85) / 1.7);\nfloat wide = 0.62 * sqrt(max(1.0 - h, 0.0)) * (1.0 - 0.3 * h) * (1.0 - 0.45 * age);\nfloat erode = (Noise - 0.5) * 0.35 * (0.4 + h);\nfloat d = abs(q.x) - wide + erode;\nd = max(d, q.y - 0.9 + (Noise - 0.5) * 0.3);\nd = max(d, -0.95 - q.y);\nfloat body = CkUsf_SdfEdgeAA(d);\nfloat soft = saturate(-d / max(Softness, 1e-3));\nfloat hot = saturate(1.0 - h * 1.4 - age * 0.8);\nfloat3 col = lerp(PC, Core, hot * hot);\ncol = lerp(col, Tip, saturate(h * 0.8 + age * 0.9 - 0.4));\nfloat fade = (1.0 - age * age) * flick * Dyn.z;\nreturn col * (body * 0.6 + soft * 0.4) * fade;",
					"Description": "Flame Sprite",
					"IncludeFilePaths": [
						"/CkUsf/Common.ush"
					]
				}
			},
