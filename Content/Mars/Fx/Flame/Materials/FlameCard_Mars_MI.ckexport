						"node": 1,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 8,
						"name": "Tip",
						"node": 2,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 9,
						"name": "Colour",
						"node": 0,
						"output": 0,
						"mask": "rgb"
					},
					{
						"index": 10,
						"name": "Warp",
						"node": 13,
						"output": 0
					},
					{
						"index": 11,
						"name": "Erode",
						"node": 14,
						"output": 0
					},
					{
						"index": 12,
						"name": "Tear",
						"node": 15,
						"output": 0
					},
					{
						"index": 13,
						"name": "Feather",
						"node": 5,
						"output": 0
					}
				],
				"outputs": [
					"return",
					"Mask"
				],
				"props":
				{
					"Code": "float2 q = float2(UV.x - 0.5, 0.5 - UV.y) * 2.0;\n// the flame spans q.y -0.9 (foot) .. 0.8 (tip); the card is about twice the flame's width\nfloat h = saturate((q.y + 0.9) / 1.7);\n// the upper flame wavers side to side on the coarse noise\nq.x += (Noise - 0.5) * Warp * h * h;\n// a round foot (a quarter circle over the lowest fifth) narrowing to the tip: no flat bottom\nfloat foot = h < 0.2 ? sqrt(saturate(h * (0.4 - h))) / 0.2 : 1.0;\nfloat wide = 0.42 * foot * sqrt(max(1.0 - h, 0.0)) * (1.0 - 0.3 * h);\nfloat erode = (Noise - 0.5) * Erode * (0.2 + h) * 0.7 + (Detail - 0.5) * Erode * h * h;\nfloat d = abs(q.x) - wide + erode;\nd += max(q.y - 0.8, 0.0) * 3.0 + max(-0.9 - q.y, 0.0) * 3.0;\n// above mid-height the flame tears into licks wherever the fine noise is low (blended in by height: a plain max with 0\n// below it would push the whole lower flame onto its edge)\nd = lerp(d, max(d, (Tear - Detail) * 0.6), smoothstep(0.35, 0.85, h));\n// a guttering flame (Intensity dipping) shrinks a little as well as dimming\nd += (1.0 - saturate(Intensity)) * 0.12;\n// nothing ever reaches the quad's border, whatever the noise does\nfloat border = saturate((1.0 - abs(q.x)) / 0.25) * saturate((1.0 - q.y) / 0.2) * saturate((q.y + 1.0) / 0.1);\n// translucent coverage: a soft edge Feather wide (never sharper than a pixel)\nMask = saturate(0.5 - d / max(Feather, fwidth(d))) * border;\n// solid inside: hot core, the flame colour toward the edge, darker at the very edge and the foot\nfloat inner = saturate(-d / max(Softness, 1e-3));\nfloat hot = saturate(1.0 - h * 1.4) * inner;\nfloat3 col = lerp(Colour, Core, hot * hot);\ncol = lerp(col, Tip, saturate(h * 0.8 - 0.4));\ncol *= lerp(0.55, 1.0, inner) * lerp(0.8, 1.15, Detail) * lerp(0.6, 1.0, smoothstep(0.0, 0.18, h));\nreturn col * Flicker.x * lerp(0.35, 1.0, saturate(Intensity)) * Strength;",
					"Description": "Flame Card PS",
					"IncludeFilePaths": [
						"/CkUsf/Common.ush"
					]
				}
			},
