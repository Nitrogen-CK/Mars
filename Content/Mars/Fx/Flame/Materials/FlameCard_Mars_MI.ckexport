			{
				"id": 30,
				"class": "Custom",
				"name": "MaterialExpressionCustom_40",
				"inputs": [
					{
						"index": 0,
						"name": "Time",
						"node": 26,
						"output": 0
					},
					{
						"index": 1,
						"name": "Speed",
						"node": 7,
						"output": 0
					},
					{
						"index": 2,
						"name": "Phase",
						"node": 20,
						"output": 0
					},
					{
						"index": 3,
						"name": "Amount",
						"node": 8,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float t = Time * Speed + Phase * 61.0;\nfloat n = sin(t * 6.1) * 0.5 + sin(t * 13.7 + 1.3) * 0.3 + sin(t * 23.3 + 2.1) * 0.2;\nfloat i = 1.0 + n * Amount;\nfloat sx = sin(t * 2.3) * 0.6 + sin(t * 5.9 + 0.7) * 0.4;\nfloat sy = sin(t * 1.9 + 1.1) * 0.6 + sin(t * 4.7 + 2.3) * 0.4;\nreturn float3(max(i, 0.05), sx, sy);",
					"Description": "Flicker"
				}
			},
			{
				"id": 31,
				"class": "Custom",
				"name": "MaterialExpressionCustom_41",
				"inputs": [
					{
						"index": 0,
						"name": "UV",
						"node": 25,
						"output": 0
					},
					{
						"index": 1,
						"name": "Phase",
						"node": 20,
						"output": 0
					}
				],
				"props":
				{
					"Code": "return UV + float2(Phase * 17.31, Phase * 5.17);",
					"OutputType": "CMOT_Float2",
					"Description": "Phased UV"
				}
			},
			{
				"id": 32,
				"class": "Custom",
				"name": "MaterialExpressionCustom_42",
				"inputs": [
					{
						"index": 0,
						"name": "UV",
						"node": 31,
						"output": 0
					},
					{
						"index": 1,
						"name": "Time",
						"node": 26,
						"output": 0
					},
					{
						"index": 2,
						"name": "Scale",
						"node": 9,
						"output": 0
					},
					{
						"index": 3,
						"name": "Speed",
						"node": 10,
						"output": 0
					}
				],
				"props":
				{
					"Code": "float2 p = UV * Scale + float2(0.0, Time * Speed);\nfloat2 i = floor(p); float2 f = frac(p); f = f * f * (3.0 - 2.0 * f);\nfloat n00 = frac(sin(dot(i + float2(0.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nfloat n10 = frac(sin(dot(i + float2(1.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nfloat n01 = frac(sin(dot(i + float2(0.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nfloat n11 = frac(sin(dot(i + float2(1.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nfloat n = lerp(lerp(n00, n10, f.x), lerp(n01, n11, f.x), f.y);\np *= 2.17; i = floor(p); f = frac(p); f = f * f * (3.0 - 2.0 * f);\nn00 = frac(sin(dot(i + float2(0.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nn10 = frac(sin(dot(i + float2(1.0, 0.0), float2(127.1, 311.7))) * 43758.5453);\nn01 = frac(sin(dot(i + float2(0.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nn11 = frac(sin(dot(i + float2(1.0, 1.0), float2(127.1, 311.7))) * 43758.5453);\nreturn n * 0.65 + lerp(lerp(n00, n10, f.x), lerp(n01, n11, f.x), f.y) * 0.35;",
					"OutputType": "CMOT_Float1",
					"Description": "Erosion Noise"
				}
			},
